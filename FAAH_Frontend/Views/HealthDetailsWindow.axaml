<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="FAAH_Frontend.Views.HealthDetailsWindow"
        Title="FAAH API health"
        Width="420"
        Height="680"
        MinWidth="420" MinHeight="450"
        CanResize="True"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Surface}">
    <Grid Margin="24" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="16">
        <StackPanel Spacing="4">
            <TextBlock Text="API health" FontSize="22" FontWeight="Bold"/>
            <TextBlock Text="Internal API and external data sources" Opacity="0.7"/>
        </StackPanel>

        <Border Grid.Row="1" Padding="14" CornerRadius="6"
                Background="{StaticResource SurfaceAlt}"
                BorderBrush="{StaticResource Hairline}"
                BorderThickness="1">
            <StackPanel Spacing="6">
                <TextBlock Text="{Binding StatusLabel}" FontWeight="Bold"
                           Foreground="{StaticResource TextPrimary}"/>
                <TextBlock Text="{Binding Summary}" TextWrapping="Wrap"
                           Foreground="{StaticResource TextPrimary}"/>
                <TextBlock Text="{Binding CheckedAt}" FontSize="11"
                           Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="12">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="Database"/>
                    <TextBlock Grid.Column="1" Text="{Binding DatabaseStatus}"
                               Foreground="{StaticResource Muted}"/>
                </Grid>
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="Orchestrator"/>
                    <TextBlock Grid.Column="1" Text="{Binding OrchestratorStatus}"
                               Foreground="{StaticResource Muted}"/>
                </Grid>
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="Portfolio strategists"/>
                    <TextBlock Grid.Column="1" Text="{Binding StrategistStatus}"
                               Foreground="{StaticResource Muted}"/>
                </Grid>
                <TextBlock Text="{Binding StrategistDetails}" FontSize="11"
                           Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="RSS feeds"/>
                    <TextBlock Grid.Column="1" Text="{Binding RssStatus}"
                               Foreground="{StaticResource Muted}"/>
                </Grid>
                <TextBlock Text="{Binding RssDetails}" FontSize="11"
                           Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
                <Border Padding="10" CornerRadius="6"
                        Background="{StaticResource SurfaceAlt}"
                        BorderBrush="{StaticResource Hairline}"
                        BorderThickness="1">
                    <StackPanel Spacing="5">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="Live market worker" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="1" Text="{Binding LiveMarketWorkerStatus}"
                                       Foreground="{Binding LiveMarketWorkerColor}" FontWeight="SemiBold"/>
                        </Grid>
                        <TextBlock FontSize="11" Foreground="{StaticResource Muted}">
                            <Run Text="Assets followed: "/><Run Text="{Binding LiveMarketWorkerAssets}"/>
                        </TextBlock>
                        <WrapPanel ItemSpacing="14" LineSpacing="2">
                            <TextBlock FontSize="11" Foreground="{StaticResource Muted}">
                                <Run Text="Live prices: "/><Run Text="{Binding LiveMarketWorkerLivePrices}"/>
                            </TextBlock>
                            <TextBlock FontSize="11" Foreground="{StaticResource Muted}">
                                <Run Text="Delayed prices: "/><Run Text="{Binding LiveMarketWorkerDelayedPrices}"/>
                            </TextBlock>
                            <TextBlock FontSize="11" Foreground="{StaticResource Muted}">
                                <Run Text="Unavailable prices: "/><Run Text="{Binding LiveMarketWorkerUnavailablePrices}"/>
                            </TextBlock>
                        </WrapPanel>
                        <TextBlock IsVisible="{Binding HasLiveMarketWorkerHeartbeat}"
                                   FontSize="11" Foreground="{StaticResource Muted}">
                            <Run Text="Last heartbeat: "/><Run Text="{Binding LiveMarketWorkerHeartbeat}"/>
                        </TextBlock>
                        <TextBlock IsVisible="{Binding HasLiveMarketWorkerError}"
                                   Text="{Binding LiveMarketWorkerError}" FontSize="11"
                                   Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
                <Border Height="1" Background="{StaticResource Hairline}" Margin="0,4"/>
                <TextBlock Text="External sources" FontWeight="SemiBold"/>
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="Yahoo Finance (yfinance)"/>
                    <TextBlock Grid.Column="1" Text="{Binding YahooStatus}" Foreground="{Binding YahooColor}" FontWeight="SemiBold"/>
                </Grid>
                <TextBlock Text="{Binding YahooDetails}" FontSize="11" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="Twelve Data (logos)"/>
                    <TextBlock Grid.Column="1" Text="{Binding TwelveStatus}" Foreground="{Binding TwelveColor}" FontWeight="SemiBold"/>
                </Grid>
                <TextBlock Text="{Binding TwelveDetails}" FontSize="11" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
            <Button Content="Refresh" Command="{Binding RefreshCommand}"/>
            <Button Content="Close" Click="CloseClick"/>
        </StackPanel>
    </Grid>
</Window>
