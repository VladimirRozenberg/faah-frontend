<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="640"
             x:Class="FAAH_Frontend.Views.PortfolioView">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
  <StackPanel Margin="42,26,42,30" Spacing="20">
      <Grid ColumnDefinitions="*,Auto">
        <Button Content="← Back to portfolios" Classes="ghost" Command="{Binding BackCommand}" HorizontalAlignment="Left"/>
        <Button Grid.Column="1" Content="Refresh" Classes="ghost refreshButton" Command="{Binding RefreshCommand}" IsEnabled="{Binding !IsLoading}"/>
      </Grid>
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Spacing="5">
          <TextBlock Text="{Binding Portfolio.Name}" Classes="h1" TextWrapping="Wrap"/>
          <TextBlock Text="{Binding Portfolio.Description}" Classes="muted" TextWrapping="Wrap"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="14" VerticalAlignment="Top" HorizontalAlignment="Right">
          <Button Content="Settings" Classes="ghost" Command="{Binding EditPortfolioCommand}"/>
          <StackPanel Spacing="4" VerticalAlignment="Top">
            <ToggleSwitch IsChecked="{Binding Portfolio.IsActive, Mode=TwoWay}"
                          IsEnabled="{Binding Portfolio.CanToggleStatus}"
                          Command="{Binding ToggleStatusCommand}"
                          CommandParameter="{Binding Portfolio}"
                          ToolTip.Tip="{Binding Portfolio.StatusDisplay}"/>
            <TextBlock Text="{Binding Portfolio.StatusErrorMessage}" Foreground="{StaticResource Red}"
                       FontSize="10" TextWrapping="Wrap" IsVisible="{Binding Portfolio.HasStatusError}"/>
          </StackPanel>
        </StackPanel>
      </Grid>

      <Grid ColumnDefinitions="*,*,*,*,*" ColumnSpacing="12">
        <Border Classes="card" Padding="14">
          <StackPanel Spacing="6"><TextBlock Text="Risk" Classes="label"/><TextBlock Text="{Binding Portfolio.RiskDisplay}" FontSize="18" FontWeight="SemiBold"/></StackPanel>
        </Border>
        <Border Grid.Column="1" Classes="card" Padding="14">
          <StackPanel Spacing="6"><TextBlock Text="Max positions" Classes="label"/><TextBlock Text="{Binding Portfolio.MaxPositions}" FontSize="18" FontWeight="SemiBold"/></StackPanel>
        </Border>
        <Border Grid.Column="2" Classes="card" Padding="14">
          <StackPanel Spacing="6"><TextBlock Text="Return" Classes="label"/><TextBlock Text="{Binding Portfolio.ReturnDisplay}" FontSize="18" FontWeight="SemiBold" Classes.up="{Binding Portfolio.IsUp}" Classes.down="{Binding Portfolio.IsDown}"/></StackPanel>
        </Border>
        <Border Grid.Column="3" Classes="card" Padding="14">
          <StackPanel Spacing="6"><TextBlock Text="Base currency" Classes="label"/><TextBlock Text="{Binding Portfolio.BaseCurrency}" FontSize="18" FontWeight="SemiBold"/></StackPanel>
        </Border>
        <Border Grid.Column="4" Classes="card" Padding="14">
          <StackPanel Spacing="6"><TextBlock Text="Agent" Classes="label"/><TextBlock Text="{Binding Portfolio.StatusDisplay}" FontSize="18" FontWeight="SemiBold"/></StackPanel>
        </Border>
      </Grid>

      <Grid ColumnDefinitions="*,*" ColumnSpacing="20" MinHeight="380">
        <Border Classes="card" Padding="20">
          <StackPanel Spacing="12">
            <TextBlock Text="Assets / positions" Classes="h2"/>
            <TextBlock Text="Loading portfolio positions…" Classes="muted" IsVisible="{Binding IsLoadingPositions}"/>
            <TextBlock Text="{Binding PositionsErrorMessage}" Foreground="{StaticResource Red}" TextWrapping="Wrap" IsVisible="{Binding HasPositionsError}"/>
            <TextBlock Text="{Binding FavoritesErrorMessage}" Foreground="{StaticResource Red}" TextWrapping="Wrap" IsVisible="{Binding HasFavoritesError}"/>
            <TextBlock Text="No positions in this portfolio." Classes="muted" IsVisible="{Binding IsPositionsEmpty}"/>
            <Grid ColumnDefinitions="1.5*,*,*,*,*,72" ColumnSpacing="8">
              <TextBlock Classes="colHead" Text="ASSET"/>
              <TextBlock Grid.Column="1" Classes="colHead" Text="QUANTITY" HorizontalAlignment="Right"/>
              <TextBlock Grid.Column="2" Classes="colHead" Text="AVG. COST" HorizontalAlignment="Right"/>
              <TextBlock Grid.Column="3" Classes="colHead" Text="PRICE" HorizontalAlignment="Right"/>
              <TextBlock Grid.Column="4" Classes="colHead" Text="VALUE" HorizontalAlignment="Right"/>
              <TextBlock Grid.Column="5" Classes="colHead" Text="FAVORITE" HorizontalAlignment="Center"/>
            </Grid>
            <ItemsControl ItemsSource="{Binding Positions}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid Classes="portfolioPositionContainer" ColumnDefinitions="*,72" ColumnSpacing="8" Margin="0,0,0,4">
                    <Border Grid.ColumnSpan="2" Classes="portfolioPositionRow" Classes.zebra="{Binding IsAlternateRow}"/>
                    <Button Grid.Column="1" Content="{Binding StarGlyph}" Classes="rowButton portfolioPositionAction" Padding="0"
                            Foreground="{StaticResource Amber}" FontSize="18" HorizontalContentAlignment="Center"
                            Command="{Binding $parent[UserControl].DataContext.ToggleFavoriteCommand}"
                            CommandParameter="{Binding}" ToolTip.Tip="Toggle favorite"/>
                    <Button Classes="rowButton portfolioPositionAction" Padding="8,10"
                            Command="{Binding $parent[UserControl].DataContext.OpenAssetCommand}" CommandParameter="{Binding}">
                      <Grid ColumnDefinitions="1.5*,*,*,*,*" ColumnSpacing="8">
                        <StackPanel Spacing="2">
                          <TextBlock Text="{Binding Symbol}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                          <TextBlock Text="{Binding Name}" Classes="muted" FontSize="11" TextWrapping="Wrap"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding QuantityDisplay}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="{Binding AveragePurchasePriceDisplay}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="3" Text="{Binding CurrentPriceDisplay}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="4" Spacing="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                          <TextBlock Text="{Binding CurrentValueDisplay}" HorizontalAlignment="Right"/>
                          <TextBlock Text="{Binding ProfitLossDisplay}" Classes.up="{Binding IsProfit}" Classes.down="{Binding IsLoss}" FontSize="11" HorizontalAlignment="Right"/>
                        </StackPanel>
                      </Grid>
                    </Button>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0" IsVisible="{Binding HasPositions}">
              <TextBlock Text="TOTAL VALUE" Classes="colHead" FontWeight="SemiBold"/>
              <TextBlock Grid.Column="1" Text="{Binding TotalPositionValueDisplay}" FontWeight="SemiBold"/>
            </Grid>
            <Border Classes="rule" Margin="0,8,0,4"/>
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="Transactions" Classes="h2"/>
              <TextBlock Grid.Column="1" Text="{Binding TransactionCount}" Classes="muted"/>
            </Grid>
            <TextBlock Text="Loading transactions…" Classes="muted" IsVisible="{Binding IsLoadingTransactions}"/>
            <TextBlock Text="{Binding TransactionsErrorMessage}" Foreground="{StaticResource Red}" TextWrapping="Wrap" IsVisible="{Binding HasTransactionsError}"/>
            <TextBlock Text="No transactions for this portfolio." Classes="muted" IsVisible="{Binding IsTransactionsEmpty}"/>
            <ItemsControl ItemsSource="{Binding Transactions}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Classes="row" Classes.zebra="{Binding IsAlternateRow}" Padding="10" Margin="0,0,0,6">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                      <Border Classes="pill" Classes.green="{Binding IsBuy}" Classes.red="{Binding IsSell}" VerticalAlignment="Top">
                        <TextBlock Text="{Binding TypeDisplay}" FontSize="11" FontWeight="SemiBold"/>
                      </Border>
                      <StackPanel Grid.Column="1" Spacing="3">
                        <TextBlock Text="{Binding Symbol}" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding Name}" Classes="muted" FontSize="11" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding CreatedAtDisplay}" Classes="muted" FontSize="11"/>
                      </StackPanel>
                      <StackPanel Grid.Column="2" Spacing="3" HorizontalAlignment="Right">
                        <TextBlock Text="{Binding QuantityDisplay}" HorizontalAlignment="Right"/>
                        <TextBlock Classes="muted" FontSize="11" HorizontalAlignment="Right">
                          <Run Text="@ "/><Run Text="{Binding PriceDisplay}"/><Run Text=" "/><Run Text="{Binding Currency}"/>
                        </TextBlock>
                        <TextBlock FontWeight="SemiBold" HorizontalAlignment="Right">
                          <Run Text="{Binding AmountDisplay}"/><Run Text=" "/><Run Text="{Binding Currency}"/>
                        </TextBlock>
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="4" IsVisible="{Binding HasMultipleTransactionPages}">
              <Button Classes="page" Content="«" ToolTip.Tip="First page" Command="{Binding FirstTransactionPageCommand}"/>
              <Button Classes="page" Content="‹" ToolTip.Tip="Previous page" Command="{Binding PreviousTransactionPageCommand}"/>
              <ItemsControl ItemsSource="{Binding TransactionPageNumbers}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="4"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate><DataTemplate><Button Classes="page" Content="{Binding}" Command="{Binding $parent[ItemsControl].DataContext.GoToTransactionPageCommand}" CommandParameter="{Binding}"/></DataTemplate></ItemsControl.ItemTemplate>
              </ItemsControl>
              <Button Classes="page" Content="›" ToolTip.Tip="Next page" Command="{Binding NextTransactionPageCommand}"/>
              <Button Classes="page" Content="»" ToolTip.Tip="Last page" Command="{Binding LastTransactionPageCommand}"/>
              <TextBlock Text="{Binding TransactionPageLabel}" Classes="muted" FontSize="11" VerticalAlignment="Center" Margin="6,0,0,0"/>
            </StackPanel>
          </StackPanel>
        </Border>

        <Border Grid.Column="1" Classes="card" Padding="20">
          <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Spacing="3">
                <TextBlock Text="Portfolio recommendations" Classes="h2"/>
                <TextBlock Text="Newest first · filter by kind." Classes="muted" TextWrapping="Wrap"/>
              </StackPanel>
            </Grid>

            <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="10" Margin="0,14,0,10">
              <StackPanel Spacing="4">
                <TextBlock Text="Kind" Classes="label"/>
                <ComboBox Width="220" ItemsSource="{Binding KindOptions}" SelectedItem="{Binding SelectedKindDisplay, Mode=TwoWay}" IsEnabled="{Binding !IsLoading}"/>
              </StackPanel>
            </StackPanel>

            <StackPanel Grid.Row="2" Spacing="8" Margin="0,0,0,10">
                          <TextBlock Text="Loading recommendations…" Classes="muted" IsVisible="{Binding IsLoading}"/>
              <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource Red}" TextWrapping="Wrap" IsVisible="{Binding HasError}"/>
              <TextBlock Text="No recommendations match this filter." Classes="muted" TextWrapping="Wrap" IsVisible="{Binding IsEmpty}"/>
            </StackPanel>

              <ItemsControl Grid.Row="3" ItemsSource="{Binding Recommendations}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Button Classes="rowButton" Classes.zebra="{Binding IsAlternateRow}" Padding="14" Margin="0,0,0,10"
                            Command="{Binding $parent[UserControl].DataContext.OpenAssetCommand}" CommandParameter="{Binding}">
                      <StackPanel Spacing="8">
                        <Grid ColumnDefinitions="*,Auto">
                          <StackPanel Spacing="3">
                            <TextBlock Text="{Binding AssetSymbolDisplay}" FontSize="16" FontWeight="SemiBold"/>
                            <TextBlock Classes="muted" FontSize="11">
                              <Run Text="Recommendation #"/><Run Text="{Binding RecommendationId}"/>
                              <Run Text=" · "/><Run Text="{Binding Kind}"/>
                            </TextBlock>
                          </StackPanel>
                          <Border Grid.Column="1" Classes="pill">
                            <TextBlock Text="{Binding Action}" FontWeight="SemiBold"/>
                          </Border>
                        </Grid>
                        <TextBlock Text="{Binding Reason}" TextWrapping="Wrap"/>
                        <WrapPanel ItemSpacing="12" LineSpacing="4">
                          <TextBlock Text="{Binding ConfidenceDisplay}" Classes="muted"/>
                                                    <TextBlock Text="{Binding CreatedAtDisplay}" Classes="muted"/>
                          <TextBlock Text="{Binding SignalDisplay}" Classes="muted" IsVisible="{Binding HasSignalId}"/>
                        </WrapPanel>
                      </StackPanel>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

            <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="4" Margin="0,10,0,0" HorizontalAlignment="Center">
              <Button Classes="page" Content="«" ToolTip.Tip="First page" Command="{Binding FirstPageCommand}"/>
              <Button Classes="page" Content="‹" ToolTip.Tip="Previous page" Command="{Binding PreviousPageCommand}"/>
              <ItemsControl ItemsSource="{Binding PageNumbers}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="4"/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Button Classes="page" Content="{Binding}"
                            Command="{Binding $parent[ItemsControl].DataContext.GoToPageCommand}"
                            CommandParameter="{Binding}"/>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Button Classes="page" Content="›" ToolTip.Tip="Next page" Command="{Binding NextPageCommand}"/>
              <Button Classes="page" Content="»" ToolTip.Tip="Last page" Command="{Binding LastPageCommand}"/>
              <TextBlock Text="{Binding PageLabel}" Classes="muted" FontSize="11" VerticalAlignment="Center" Margin="6,0,0,0"/>
            </StackPanel>
          </Grid>
        </Border>
      </Grid>
  </StackPanel>
  </ScrollViewer>
</UserControl>
