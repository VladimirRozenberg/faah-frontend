<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="700"
        x:Class="FAAH_Frontend.Views.MainWindow"
        Title="FAAH — Futures Arbitrage Assets Hub"
        Width="1100" Height="700"
        MinWidth="900" MinHeight="600"
        WindowDecorations="None" CanResize="True"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource NavyDeep}">

    <Window.Icon>
        <WindowIcon>avares://FAAH_Frontend/Assets/faah-logo.ico</WindowIcon>
    </Window.Icon>

    <Grid RowDefinitions="38,*" Background="{StaticResource Surface}">
        <Border Grid.Row="0" Classes="windowTitleBar" Background="{StaticResource NavyDeep}">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <Border Grid.Column="0" Classes="windowCaptionBrand" Background="Transparent"
                        PointerPressed="TitleBarPointerPressed">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="8">
                        <Image Source="avares://FAAH_Frontend/Assets/faah-logo.png"
                               Width="26" Height="26" Stretch="Uniform"/>
                        <TextBlock Text="FAAH" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="FUTURES ARBITRAGE ASSETS HUB" FontSize="9"
                                   Foreground="#AFC0D0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Background="Transparent" PointerPressed="TitleBarPointerPressed"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Stretch" Spacing="0">
                    <Button Classes="windowChromeButton" Content="—" ToolTip.Tip="Minimize"
                            Click="MinimizeClick"/>
                    <Button x:Name="MaximizeRestoreButton" Classes="windowChromeButton" Content="□"
                            ToolTip.Tip="Maximize or restore" Click="MaximizeRestoreClick"/>
                    <Button Classes="windowChromeButton windowCloseButton" Content="×" ToolTip.Tip="Close"
                            Click="CloseClick"/>
                </StackPanel>
            </Grid>
        </Border>

    <DockPanel Grid.Row="1">

        <!-- ================= BARRE DE NAVIGATION ================= -->
        <Border DockPanel.Dock="Top" Height="74" IsVisible="{Binding IsLoggedIn}"
                Background="{StaticResource NavyDeep}">
            <Grid RowDefinitions="*,1" ColumnDefinitions="Auto,*,Auto" Margin="24,0">
                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal"
                            HorizontalAlignment="Left" VerticalAlignment="Center" Spacing="4">
                    <Button Classes="navItem" Classes.active="{Binding IsDashboardActive}"
                            Command="{Binding ShowDashboardCommand}">
                        <Grid RowDefinitions="Auto,2">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <TextBlock Classes="idx" Text="01"/><TextBlock Text="DASHBOARD"/>
                            </StackPanel>
                            <Border Grid.Row="1" Classes="navUnderline" IsVisible="{Binding IsDashboardActive}"/>
                        </Grid>
                    </Button>
                    <Button Classes="navItem" Classes.active="{Binding IsPortfolioActive}"
                            Command="{Binding ShowPortfoliosCommand}">
                        <Grid RowDefinitions="Auto,2">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <TextBlock Classes="idx" Text="02"/><TextBlock Text="PORTFOLIO"/>
                            </StackPanel>
                            <Border Grid.Row="1" Classes="navUnderline" IsVisible="{Binding IsPortfolioActive}"/>
                        </Grid>
                    </Button>
                    <Button Classes="navItem" Classes.active="{Binding IsAssetsActive}"
                            Command="{Binding ShowAssetsCommand}">
                        <Grid RowDefinitions="Auto,2">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <TextBlock Classes="idx" Text="03"/><TextBlock Text="ASSETS"/>
                            </StackPanel>
                            <Border Grid.Row="1" Classes="navUnderline" IsVisible="{Binding IsAssetsActive}"/>
                        </Grid>
                    </Button>
                    <Button Classes="navItem" Classes.active="{Binding IsNewsActive}"
                            Command="{Binding ShowNewsCommand}">
                        <Grid RowDefinitions="Auto,2">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <TextBlock Classes="idx" Text="04"/><TextBlock Text="NEWS"/>
                            </StackPanel>
                            <Border Grid.Row="1" Classes="navUnderline" IsVisible="{Binding IsNewsActive}"/>
                        </Grid>
                    </Button>
                    <Button Classes="navItem" Classes.active="{Binding IsOrchestratorActive}" Command="{Binding ShowOrchestratorCommand}" IsVisible="{Binding IsAdmin}"><Grid RowDefinitions="Auto,2"><StackPanel Orientation="Horizontal" Spacing="7"><TextBlock Classes="idx" Text="05"/><TextBlock Text="ORCHESTRATOR"/></StackPanel><Border Grid.Row="1" Classes="navUnderline" IsVisible="{Binding IsOrchestratorActive}"/></Grid></Button>
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal"
                            VerticalAlignment="Center" Spacing="10">
                    <Button Classes="healthButton topbarHealth" Command="{Binding ShowHealthCommand}"
                            ToolTip.Tip="Open API health details">
                        <Border CornerRadius="13" Background="#1AFFFFFF" Padding="14,6" MinWidth="112">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                        VerticalAlignment="Center" Spacing="8">
                                <Ellipse Width="11" Height="11" Classes="healthDot"
                                         Classes.healthy="{Binding Health.IsHealthy}"/>
                                <TextBlock FontSize="12" FontWeight="Bold" Foreground="#FFFFFF"
                                           VerticalAlignment="Center">
                                    <Run Text="API "/><Run Text="{Binding Health.StatusLabel}"/>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </Button>

                    <Button Classes="userChip topbarUser">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Border Width="30" Height="30" CornerRadius="15" Background="{StaticResource Amber}">
                                <TextBlock Text="{Binding Initials}" FontSize="11" FontWeight="Bold"
                                           Foreground="{StaticResource NavyDeep}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Spacing="0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding UserName}" FontSize="14" FontWeight="Bold"
                                           Foreground="#FFFFFF"/>
                                <TextBlock Text="ACCOUNT" FontSize="9" FontWeight="Bold"
                                           Foreground="#AFC0D0"/>
                            </StackPanel>
                            <TextBlock Text="⌄" FontSize="14" Foreground="#AFC0D0" VerticalAlignment="Center"/>
                        </StackPanel>

                        <Button.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                                <MenuItem Header="Admin Console" Command="{Binding ShowUsersCommand}"
                                          IsVisible="{Binding IsAdmin}"/>
                                <MenuItem Header="My profile" Command="{Binding ShowProfileCommand}"/>
                                <MenuItem Header="Settings" Command="{Binding ShowSettingsCommand}"/>
                                <MenuItem Header="Log out" Command="{Binding LogoutCommand}"
                                          Foreground="{StaticResource Red}"/>
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>
                <Border Grid.Row="1" Grid.ColumnSpan="3" Background="#405A748A"/>
            </Grid>
        </Border>

        <!-- ================= PAGE COURANTE ================= -->
        <ContentControl Content="{Binding CurrentPage}"/>

    </DockPanel>
    </Grid>
</Window>
