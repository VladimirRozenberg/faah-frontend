<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="620"
             x:Class="FAAH_Frontend.Views.PortfolioListView">

    <Grid Margin="42,26,42,20" RowDefinitions="Auto,Auto,Auto,*">

        <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
            <TextBlock Text="Portfolios" Classes="h1"/>
            <Button Grid.Column="1" Classes="primary" Content="Create new portfolio"
                    Command="{Binding CreateCommand}"/>
        </Grid>
        <Border Grid.Row="1" Classes="rule" Margin="0,12,0,0"/>

        <Grid Grid.Row="2" ColumnDefinitions="2.6*,1*,1.3*,1*,1*,1*" Margin="6,22,6,10">
            <TextBlock Grid.Column="1" Classes="colHead" Text="RISK"/>
            <TextBlock Grid.Column="2" Classes="colHead" Text="MAX POSITIONS"/>
            <TextBlock Grid.Column="3" Classes="colHead" Text="RETURN"/>
            <TextBlock Grid.Column="4" Classes="colHead" Text="BASE CURRENCY"/>
            <TextBlock Grid.Column="5" Classes="colHead" Text="STATUS"/>
        </Grid>

        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Portfolios}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Classes="row" Classes.zebra="{Binding IsAlternateRow}">
                        <Grid ColumnDefinitions="2.6*,1*,1.3*,1*,1*,1*">
                            <Button Grid.Column="0" Grid.ColumnSpan="5" Classes="rowButton" Classes.zebra="{Binding IsAlternateRow}"
                                    Command="{Binding $parent[ItemsControl].DataContext.OpenCommand}"
                                    CommandParameter="{Binding}">
                                <Grid ColumnDefinitions="2.6*,1*,1.3*,1*,1*">
                                <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Description}" Classes="muted" FontSize="12"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Classes="cell" Text="{Binding RiskDisplay}"/>
                                <TextBlock Grid.Column="2" Classes="cell" Text="{Binding MaxPositions}"/>
                                <TextBlock Grid.Column="3" Classes="cell"
                                           Classes.up="{Binding IsUp}" Classes.down="{Binding IsDown}"
                                           Text="{Binding ReturnDisplay}"/>
                                <TextBlock Grid.Column="4" Classes="cell" Text="{Binding BaseCurrency}"/>
                                </Grid>
                            </Button>
                            <StackPanel Grid.Column="5" Spacing="3" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <ToggleSwitch IsChecked="{Binding IsActive, Mode=TwoWay}"
                                              IsEnabled="{Binding CanToggleStatus}"
                                              Command="{Binding $parent[ItemsControl].DataContext.ToggleStatusCommand}"
                                              CommandParameter="{Binding}"
                                              ToolTip.Tip="{Binding StatusDisplay}"/>
                                <TextBlock Text="{Binding StatusErrorMessage}" Foreground="{StaticResource Red}"
                                           FontSize="10" TextWrapping="Wrap" IsVisible="{Binding HasStatusError}"/>
                            </StackPanel>
                        </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
