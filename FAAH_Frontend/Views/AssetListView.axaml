<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="620"
              x:Class="FAAH_Frontend.Views.AssetListView"
              x:Name="AssetListRoot">

    <Grid Margin="42,26,42,20" RowDefinitions="Auto,Auto,Auto,Auto,*,Auto">

        <Grid ColumnDefinitions="*,Auto"><TextBlock Text="Assets" Classes="h1"/><Button Grid.Column="1" Content="Refresh" Classes="ghost refreshButton" Command="{Binding RefreshCommand}"/></Grid>
        <Border Grid.Row="1" Classes="rule" Margin="0,12,0,0"/>

        <StackPanel Grid.Row="2" Margin="0,12,0,0" Spacing="5">
            <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,8" MaxWidth="850" HorizontalAlignment="Left" Width="{Binding $parent[StackPanel].Bounds.Width}">
                <TextBox x:Name="AssetSearchBox" Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MaxLength="200"
                         PlaceholderText="Search by symbol or name (ex : BTC or Bitcoin)"
                         AutomationProperties.Name="Search assets by symbol or name"
                         KeyDown="SearchInputKeyDown"/>
                <Button Grid.Column="1" Content="Search" Command="{Binding SearchCommand}" Margin="8,0,0,0"/>
            </Grid>
            <TextBlock Text="{Binding SearchStatus}" Classes="muted" TextWrapping="Wrap"/>
            <TextBlock Text="{Binding Updated}" Classes="muted"/>
            <TextBlock Text="Updating assets…" IsVisible="{Binding ShowUpdatingAssets}"/>
            <TextBlock Text="{Binding Error}" IsVisible="{Binding HasError}" Foreground="{StaticResource Red}" TextWrapping="Wrap"/>
            <TextBlock Text="No assets found." IsVisible="{Binding IsEmpty}"/>
        </StackPanel>
        <Grid x:Name="CatalogGrid" Grid.Row="3" Grid.RowSpan="2" ColumnDefinitions="*,240" RowDefinitions="Auto,Auto,*">
        <Grid Grid.Row="1" ColumnDefinitions="2*,1.2*,1.2*,1.2*,60" Margin="6,20,6,8">
            <TextBlock Grid.Column="0" Classes="colHead" Text="SYMBOL"/>
            <TextBlock Grid.Column="1" Classes="colHead" Text="PRICE" HorizontalAlignment="Center"/>
            <TextBlock Grid.Column="2" Classes="colHead" Text="DAILY CHANGE" HorizontalAlignment="Center"/>
            <TextBlock Grid.Column="3" Classes="colHead" Text="VOLUME" HorizontalAlignment="Center"/>
        </Grid>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Assets}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Classes="row" Classes.zebra="{Binding IsAlternateRow}" CornerRadius="4" Padding="6,10" Margin="0,0,0,2">
                            <Grid ColumnDefinitions="2*,1.2*,1.2*,1.2*,60">
                                <Button Grid.ColumnSpan="4" Classes="assetOpen" Background="Transparent" BorderThickness="0"
                                        HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Cursor="Hand"
                                        Command="{Binding $parent[ItemsControl].DataContext.OpenAssetCommand}"
                                        CommandParameter="{Binding}" ToolTip.Tip="Open asset details"
                                        AutomationProperties.Name="{Binding Symbol}"/>
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10"
                                            VerticalAlignment="Center" IsHitTestVisible="False">
                                    <!-- Une image reçue remplace les initiales. Sinon, le rond reste visible. AVEC LE !HASLOGO -->
                                    <Grid Width="24" Height="24">
                                        <Border CornerRadius="12" Background="{Binding IconColor}" IsVisible="{Binding !HasLogo}">
                                            <TextBlock Text="{Binding IconText}" FontSize="11" FontWeight="Bold"
                                                       Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <Image Source="{Binding Logo}" IsVisible="{Binding HasLogo}" Stretch="Uniform"/>
                                    </Grid>
                                    <TextBlock Classes="cell" Text="{Binding Symbol}"/>
                                </StackPanel>
                                 <TextBlock Grid.Column="1" Classes="cell" Text="{Binding PriceDisplay}"
                                            ToolTip.Tip="{Binding PreviousCloseDisplay}"
                                            HorizontalAlignment="Center" IsHitTestVisible="False"/>
                                <TextBlock Grid.Column="2" Classes="cell"
                                           Classes.up="{Binding IsUp}" Classes.down="{Binding IsDown}"
                                            Text="{Binding ChangeDisplay}" ToolTip.Tip="{Binding ChangeAmountDisplay}"
                                            HorizontalAlignment="Center" IsHitTestVisible="False"/>
                                 <TextBlock Grid.Column="3" Classes="cell" Text="{Binding Volume}"
                                            ToolTip.Tip="{Binding MarketStatus}"
                                           HorizontalAlignment="Center" IsHitTestVisible="False"/>
                                <Button Grid.Column="4" Classes="star" Classes.off="{Binding !IsFavorite}"
                                        Command="{Binding $parent[ItemsControl].DataContext.ToggleFavoriteCommand}" CommandParameter="{Binding}" ToolTip.Tip="Add or remove favorite" Content="{Binding StarGlyph}" HorizontalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

            <Border x:Name="FiltersPanel" Grid.Column="1" Grid.RowSpan="3" Margin="16,12,0,0"
                    Background="{StaticResource SurfaceAlt}" Padding="14" CornerRadius="8">
                <Grid RowDefinitions="Auto,*">
                    <TextBlock Text="Filters" FontSize="16" FontWeight="SemiBold"/>
                    <ScrollViewer x:Name="FilterScroll" Grid.Row="1" Margin="0,12,-8,0" Padding="0" VerticalScrollBarVisibility="Auto" MaxHeight="560">
                        <StackPanel Spacing="10" Margin="0,12,22,0">
                            <TextBlock Text="Asset type" Classes="label"/>
                            <ComboBox x:Name="AssetTypeFilterBox" ItemsSource="{Binding AssetTypeOptions}" SelectedItem="{Binding AssetTypeFilter, Mode=TwoWay}" HorizontalAlignment="Stretch"/>
                            <StackPanel x:Name="NicheFilterPanel" Spacing="8" IsVisible="{Binding ShowSectorFilter}">
                                <TextBlock Text="Sector / niche" Classes="label"/>
                                <TextBox Text="{Binding NicheSearch, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Search niches (ex : energy)"/>
                                <ComboBox ItemsSource="{Binding NicheOptions}" SelectedItem="{Binding SelectedNiche, Mode=TwoWay}" HorizontalAlignment="Stretch">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate><TextBlock Text="{Binding Name}" TextWrapping="Wrap" MaxWidth="210"/></DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <TextBlock Text="{Binding NicheError}" IsVisible="{Binding HasNicheError}" Classes="muted" TextWrapping="Wrap"/>
                            </StackPanel>
                            <TextBlock Text="Currency" Classes="label"/>
                            <TextBox Text="{Binding CurrencyFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="ex : USD" MaxLength="20"/>
                            <TextBlock Text="Country" Classes="label"/>
                            <TextBox Text="{Binding CountryFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="ex : United States" MaxLength="100"/>
                            <TextBlock Text="Exchange" Classes="label"/>
                            <TextBox Text="{Binding ExchangeFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="ex : NYQ" MaxLength="50"/>
                            <CheckBox x:Name="FavoritesFilterBox" Content="Favorites only" IsChecked="{Binding FavoritesOnly, Mode=TwoWay}"/>
                            <TextBlock Text="Type part of a name to filter automatically. Empty fields mean all."
                                       Classes="muted" FontSize="11" TextWrapping="Wrap"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <StackPanel Grid.Row="5" Orientation="Horizontal" Spacing="5" Margin="6,18,0,0"
                    HorizontalAlignment="Center">
            <Button Classes="page" Content="«" ToolTip.Tip="First page" Command="{Binding FirstPageCommand}"/>
            <Button Classes="page" Content="‹" ToolTip.Tip="Previous page" Command="{Binding PreviousPageCommand}"/>
            <ItemsControl ItemsSource="{Binding PageNumbers}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="5"/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Classes="page" Content="{Binding}" Click="PageNumberClick"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button Classes="page" Content="›" ToolTip.Tip="Next page" Command="{Binding NextPageCommand}"/>
            <Button Classes="page" Content="»" ToolTip.Tip="Last page" Command="{Binding LastPageCommand}"/>
            <TextBox Width="58" Text="{Binding PageInput, Mode=TwoWay}" KeyDown="PageInputKeyDown"
                     PlaceholderText="Page" HorizontalContentAlignment="Center"/>
            <TextBlock Text="{Binding PageLabel}" Classes="muted" FontSize="12"
                       VerticalAlignment="Center" Margin="8,0,0,0"/>
        </StackPanel>
    </Grid>
</UserControl>
