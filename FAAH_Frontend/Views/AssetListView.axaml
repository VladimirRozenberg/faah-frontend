<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="620"
             x:Class="FAAH_Frontend.Views.AssetListView">

    <Grid Margin="42,26,42,20" RowDefinitions="Auto,Auto,Auto,*,Auto">

        <TextBlock Grid.Row="0" Text="Assets" Classes="h1"/>
        <Border Grid.Row="1" Classes="rule" Margin="0,12,0,0"/>

        <Grid Grid.Row="2" ColumnDefinitions="2*,1.2*,1.2*,1.2*,60" Margin="6,20,6,8">
            <TextBlock Grid.Column="0" Classes="colHead" Text="SYMBOL"/>
            <TextBlock Grid.Column="1" Classes="colHead" Text="PRICE" HorizontalAlignment="Center"/>
            <TextBlock Grid.Column="2" Classes="colHead" Text="24H" HorizontalAlignment="Center"/>
            <TextBlock Grid.Column="3" Classes="colHead" Text="VOLUME" HorizontalAlignment="Center"/>
        </Grid>

        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Assets}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Classes="row" CornerRadius="4" Padding="6,10" Margin="0,0,0,2">
                            <Grid ColumnDefinitions="2*,1.2*,1.2*,1.2*,60">
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10"
                                            VerticalAlignment="Center">
                                    <Border Width="20" Height="20" CornerRadius="10" Background="{Binding IconColor}">
                                        <TextBlock Text="{Binding IconText}" FontSize="11" FontWeight="Bold"
                                                   Foreground="#FFFFFF"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Classes="cell" Text="{Binding Symbol}"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Classes="cell" Text="{Binding PriceDisplay}"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Classes="cell"
                                           Classes.up="{Binding IsUp}" Classes.down="{Binding IsDown}"
                                           Text="{Binding ChangeDisplay}" HorizontalAlignment="Center"/>
                                <TextBlock Grid.Column="3" Classes="cell" Text="{Binding Volume}"
                                           HorizontalAlignment="Center"/>
                                <Button Grid.Column="4" Classes="star" Classes.off="{Binding !IsFavorite}"
                                        Content="{Binding StarGlyph}" HorizontalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="4" Margin="6,18,0,0">
            <Button Classes="page" Content="«"/>
            <Button Classes="page" Content="‹"/>
            <Button Classes="page" Content="›"/>
            <Button Classes="page" Content="»"/>
            <TextBlock Text="{Binding PageLabel}" Classes="muted" FontSize="12"
                       VerticalAlignment="Center" Margin="10,0,0,0"/>
        </StackPanel>
    </Grid>
</UserControl>
