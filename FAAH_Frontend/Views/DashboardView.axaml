<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="FAAH_Frontend.Views.DashboardView">
 <Grid Margin="42,26,42,20" RowDefinitions="Auto,*">
  <Grid ColumnDefinitions="*,Auto"><TextBlock Text="Dashboard" Classes="h1"/><Button Grid.Column="1" Content="Refresh" Command="{Binding RefreshCommand}"/></Grid>
  <ScrollViewer Grid.Row="1" Margin="0,20,0,0"><StackPanel Spacing="18">
   <Border Classes="rule"/>
   <Grid ColumnDefinitions="*,*,Auto"><StackPanel Spacing="8"><TextBlock Text="Available cash" Classes="label"/><TextBlock Text="{Binding Cash}" FontSize="24"/></StackPanel><StackPanel Grid.Column="1" Spacing="8"><TextBlock Text="Asset value" ToolTip.Tip="Sum of held quantities multiplied by the latest available USD prices." Classes="label"/><TextBlock Text="{Binding Assets}" FontSize="24"/></StackPanel><Button Grid.Column="2" Content="Profile and transactions" Command="{Binding ProfileCommand}"/></Grid>
   <TextBlock Text="{Binding AccountMessage}" TextWrapping="Wrap" Classes="muted"/>
   <Border Classes="rule"/>
   <TextBlock Text="Opportunities" FontSize="24" FontWeight="Bold"/>
   <TextBlock Text="Top 10 active recommendations, ranked by confidence and then by recency." Classes="muted" TextWrapping="Wrap"/>
   <StackPanel Orientation="Horizontal" Spacing="10"><Button Content="Buy" Classes="chip" Classes.selected="{Binding IsBuy}" Command="{Binding BuyCommand}"/><Button Content="Sell" Classes="chip" Classes.selected="{Binding IsSell}" Command="{Binding SellCommand}"/></StackPanel>
   <TextBlock Text="Loading…" IsVisible="{Binding IsBusy}"/><TextBlock Text="{Binding Message}" TextWrapping="Wrap"/>
   <TextBlock Text="No active opportunities for this selection." IsVisible="{Binding IsEmpty}" Classes="muted"/>
   <ItemsControl ItemsSource="{Binding Opportunities}"><ItemsControl.ItemTemplate><DataTemplate><Border Classes="row" Padding="8,12"><Grid ColumnDefinitions="*,Auto"><StackPanel Spacing="4"><TextBlock Text="{Binding Label}" FontWeight="Bold"/><TextBlock Text="{Binding Context}" Classes="muted" TextWrapping="Wrap"/></StackPanel><Button Grid.Column="1" Content="Details" Click="OpenOpportunityDetails" Tag="{Binding}"/></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
  </StackPanel></ScrollViewer>
 </Grid>
</UserControl>
