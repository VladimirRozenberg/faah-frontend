<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="620"
             x:Class="FAAH_Frontend.Views.UserListView">

    <Grid Margin="42,26,42,20" RowDefinitions="Auto,Auto,Auto,*,Auto">

        <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
            <TextBlock Grid.Column="0" Text="Users" Classes="h1"/>
            <Button Grid.Column="1" Classes="accent" Content="New User" VerticalAlignment="Center"
                    Command="{Binding NewUserCommand}"/>
        </Grid>

        <Border Grid.Row="1" Classes="rule" Margin="0,14,0,0"/>

        <Grid Grid.Row="2" ColumnDefinitions="0.6*,2*,1.2*" Margin="6,28,6,10">
            <TextBlock Grid.Column="0" Classes="colHead" Text="ID"/>
            <TextBlock Grid.Column="1" Classes="colHead" Text="USERNAME"/>
            <TextBlock Grid.Column="2" Classes="colHead" Text="ROLE"/>
        </Grid>
        <Border Grid.Row="2" Height="1" Background="{StaticResource Hairline}" VerticalAlignment="Bottom"/>

        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
            <ItemsControl ItemsSource="{Binding Users}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Classes="row" CornerRadius="4" Padding="6,12" Margin="0,0,0,2">
                            <Grid ColumnDefinitions="0.6*,2*,1.2*">
                                <TextBlock Grid.Column="0" Classes="cell" Text="{Binding UserId}"/>
                                <TextBlock Grid.Column="1" Classes="cell" Text="{Binding Username}"/>
                                <Border Grid.Column="2" Classes="pill"
                                        Classes.green="{Binding IsAdminRole}">
                                    <TextBlock Text="{Binding RoleDisplay}"/>
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="4" Margin="6,18,0,0">
            <Button Classes="page" Content="«"/>
            <Button Classes="page" Content="‹"/>
            <Button Classes="page" Content="›"/>
            <Button Classes="page" Content="»"/>
            <TextBlock Text="{Binding PageLabel}" Classes="muted" FontSize="12"
                       VerticalAlignment="Center" Margin="10,0,0,0"/>
        </StackPanel>
    </Grid>
</UserControl>
