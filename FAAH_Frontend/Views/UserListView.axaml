<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="FAAH_Frontend.Views.UserListView">
 <Grid Margin="42,26,42,24" RowDefinitions="Auto,Auto,Auto,*,Auto">
  <Grid ColumnDefinitions="*,Auto"><TextBlock Text="Admin Console" Classes="h1"/><StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12"><Button Content="Refresh" Classes="ghost" Command="{Binding RefreshCommand}"/><Button Content="New user" Classes="accent" Command="{Binding NewUserCommand}"/></StackPanel></Grid>
  <StackPanel Grid.Row="1" Spacing="8" Margin="0,18"><TextBlock Text="Select a user to view their profile and manage their role or status." Classes="muted"/><TextBlock Text="Loading users…" IsVisible="{Binding IsBusy}"/><TextBlock Text="{Binding Message}" IsVisible="{Binding HasMessage}" TextWrapping="Wrap"/></StackPanel>
  <StackPanel Grid.Row="2" Spacing="18"><Grid ColumnDefinitions="2*,2*,120" Margin="10,10,10,0"><TextBlock Grid.Column="0" Text="EMAIL" Classes="colHead"/><TextBlock Grid.Column="1" Text="NAME" Classes="colHead"/><TextBlock Grid.Column="2" Text="STATUS" Classes="colHead" HorizontalAlignment="Center"/></Grid><Border Classes="rule"/></StackPanel>
  <ScrollViewer Grid.Row="3"><ItemsControl ItemsSource="{Binding Users}"><ItemsControl.ItemTemplate><DataTemplate>
   <Button Classes="rowButton" Command="{Binding $parent[ItemsControl].DataContext.OpenUserCommand}" CommandParameter="{Binding}" Padding="10,20" HorizontalContentAlignment="Stretch">
    <Grid ColumnDefinitions="2*,2*,120"><TextBlock Grid.Column="0" Text="{Binding Email}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,14,0"/><TextBlock Grid.Column="1" Text="{Binding Username}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,14,0"/><Border Grid.Column="2" Classes="pill" Classes.green="{Binding IsEnabled}" Classes.red="{Binding IsDisabled}" HorizontalAlignment="Center" MinWidth="100"><TextBlock Text="{Binding StatusDisplay}"/></Border></Grid>
   </Button>
  </DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
  <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="6" Margin="0,20,0,0"><Button Content="|&lt;" Classes="page" Command="{Binding FirstPageCommand}" ToolTip.Tip="First page"/><Button Content="&lt;" Classes="page" Command="{Binding PreviousPageCommand}" ToolTip.Tip="Previous page"/><Button Content="&gt;" Classes="page" Command="{Binding NextPageCommand}" ToolTip.Tip="Next page"/><Button Content="&gt;|" Classes="page" Command="{Binding LastPageCommand}" ToolTip.Tip="Last page"/><TextBlock Text="{Binding PageLabel}" VerticalAlignment="Center" Margin="12,0" Classes="muted"/></StackPanel>
 </Grid>
</UserControl>
