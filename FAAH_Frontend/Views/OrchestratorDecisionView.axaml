<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="FAAH_Frontend.Views.OrchestratorDecisionView"><Grid Margin="42,26,42,20" RowDefinitions="Auto,Auto,*,Auto"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="Orchestrator decisions" Classes="h1"/><Button Grid.Column="1" Classes="ghost compact" Content="Refresh" Command="{Binding RefreshCommand}"/></Grid><Grid Grid.Row="1" Margin="0,12,0,12" ColumnDefinitions="*,Auto"><TextBlock Text="{Binding CountDisplay}" Classes="muted"/><StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"><TextBlock Text="Page size" Classes="muted"/><ComboBox Width="88" ItemsSource="{Binding PageSizeOptions}" SelectedItem="{Binding SelectedPageSize, Mode=TwoWay}"/></StackPanel></Grid><Border Grid.Row="1" Classes="rule" VerticalAlignment="Bottom"/><Grid Grid.Row="2"><TextBlock Text="Loading decision history…" IsVisible="{Binding IsBusy}" Classes="muted"/><StackPanel IsVisible="{Binding HasError}" Spacing="8"><TextBlock Text="{Binding Error}" Foreground="{StaticResource Red}" TextWrapping="Wrap"/><Button Classes="ghost compact" Content="Retry" Command="{Binding RefreshCommand}" HorizontalAlignment="Left"/></StackPanel><TextBlock Text="No orchestrator decision history is available yet." IsVisible="{Binding IsEmpty}" Classes="muted"/><ScrollViewer VerticalScrollBarVisibility="Auto" IsVisible="{Binding !IsBusy}"><ItemsControl ItemsSource="{Binding Cycles}"><ItemsControl.ItemTemplate><DataTemplate><Border Classes="row" Classes.zebra="{Binding IsAlternateRow}" BorderBrush="{StaticResource Hairline}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,10"><StackPanel Spacing="10"><Button Classes="rowButton" Padding="0" HorizontalContentAlignment="Stretch" Command="{Binding $parent[ItemsControl].DataContext.ToggleCycleCommand}" CommandParameter="{Binding}"><StackPanel Spacing="6"><TextBlock Text="{Binding SituationSummary}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/><StackPanel Orientation="Horizontal" Spacing="12"><TextBlock Text="{Binding StartedAtDisplay}" Classes="muted"/><TextBlock Text="{Binding SourceDisplay}" Classes="muted"/><TextBlock Text="{Binding StatusDisplay}" FontWeight="SemiBold"/><TextBlock Text="{Binding CycleId}" Classes="muted"/></StackPanel></StackPanel></Button><TextBlock Text="{Binding Error}" IsVisible="{Binding HasError}" Foreground="{StaticResource Red}" TextWrapping="Wrap"/><StackPanel IsVisible="{Binding IsExpanded}" Spacing="14"><TextBlock Text="Partial historical record." IsVisible="{Binding IsPartialHistory}" Foreground="{StaticResource AmberHover}" FontWeight="SemiBold"/><StackPanel Spacing="5"><TextBlock Text="RSS decisions" Classes="h2"/><TextBlock Text="No individual RSS decision details were recorded." IsVisible="{Binding !HasRssDecisions}" Classes="muted"/><StackPanel Orientation="Horizontal" Spacing="5" IsVisible="{Binding HasRejectedRssProposals}"><TextBlock Text="Rejected proposals:" Classes="muted"/><TextBlock Text="{Binding RejectedRssProposals}"/></StackPanel>
<ItemsControl ItemsSource="{Binding RssDecisions}"><ItemsControl.ItemTemplate><DataTemplate><Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Hairline}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,4,0,0"><StackPanel Spacing="5"><TextBlock Text="{Binding Proposal.Action}" FontWeight="SemiBold"/><TextBlock Text="{Binding Proposal.Target}"/><TextBlock Text="Parameters" Classes="muted"/><TextBlock Text="{Binding Proposal.ParametersDisplay}" TextWrapping="Wrap"/><TextBlock Text="Reason" Classes="muted"/><TextBlock Text="{Binding Proposal.Reason}" TextWrapping="Wrap"/><StackPanel Orientation="Horizontal" Spacing="5"><TextBlock Text="Confidence:" Classes="muted"/><TextBlock Text="{Binding Proposal.ConfidenceDisplay}"/></StackPanel><TextBlock Text="{Binding StatusMeaning}" Classes="muted" TextWrapping="Wrap"/><TextBlock Text="{Binding RejectionReason}" IsVisible="{Binding HasRejectionReason}" Foreground="{StaticResource Red}" TextWrapping="Wrap"/><TextBlock Text="{Binding Error}" IsVisible="{Binding HasError}" Foreground="{StaticResource Red}" TextWrapping="Wrap"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel><StackPanel Spacing="5"><TextBlock Text="Requested research" Classes="h2"/><TextBlock Text="Requested items and created jobs can differ when duplicate or invalid requests are skipped." Classes="muted" TextWrapping="Wrap"/><TextBlock Text="No research requests recorded." IsVisible="{Binding !HasResearchRequests}" Classes="muted"/><ItemsControl ItemsSource="{Binding FollowUpAnalysis}"><ItemsControl.ItemTemplate><DataTemplate><Border Background="{StaticResource Surface}" Padding="10" Margin="0,4,0,0"><StackPanel Spacing="4"><TextBlock Text="Asset" Classes="muted"/><TextBlock Text="{Binding AssetSymbol}" FontWeight="SemiBold"/><TextBlock Text="Question" Classes="muted"/><TextBlock Text="{Binding Question}" TextWrapping="Wrap"/><TextBlock Text="Reason" Classes="muted"/><TextBlock Text="{Binding Reason}" TextWrapping="Wrap"/><StackPanel Orientation="Horizontal" Spacing="5"><TextBlock Text="Priority:" Classes="muted"/><TextBlock Text="{Binding PriorityDisplay}"/></StackPanel></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel>
<StackPanel Spacing="5"><TextBlock Text="Created research jobs" Classes="h2"/><TextBlock Text="No research jobs created." IsVisible="{Binding !HasResearchJobs}" Classes="muted"/><ItemsControl ItemsSource="{Binding FollowUpJobs}"><ItemsControl.ItemTemplate><DataTemplate><Border Background="{StaticResource Surface}" Padding="10" Margin="0,4,0,0"><StackPanel Spacing="4"><TextBlock Text="Asset" Classes="muted"/><TextBlock Text="{Binding AssetSymbol}" FontWeight="SemiBold"/><TextBlock Text="Question" Classes="muted"/><TextBlock Text="{Binding Question}" TextWrapping="Wrap"/><StackPanel Orientation="Horizontal" Spacing="5"><TextBlock Text="Status:" Classes="muted"/><TextBlock Text="{Binding Status}"/></StackPanel><TextBlock Text="{Binding Error}" IsVisible="{Binding HasError}" Foreground="{StaticResource Red}" TextWrapping="Wrap"/><StackPanel Orientation="Horizontal" Spacing="5" IsVisible="{Binding HasResultAnalysis}"><TextBlock Text="Analysis ID:" Classes="muted"/><TextBlock Text="{Binding ResultAnalysisId}"/></StackPanel><TextBlock Text="{Binding ResultSummary}" IsVisible="{Binding HasResultContent}" TextWrapping="Wrap"/><TextBlock Text="{Binding ResultText}" IsVisible="{Binding HasResultContent}" TextWrapping="Wrap"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock Text="Research jobs can remain pending after a cycle completes." Classes="muted" TextWrapping="Wrap"/></StackPanel><StackPanel Spacing="5"><TextBlock Text="Next-cycle instructions" Classes="h2"/><TextBlock Text="{Binding NextInstructions}" IsVisible="{Binding HasNextInstructions}" TextWrapping="Wrap"/><TextBlock Text="No next-cycle instructions recorded." IsVisible="{Binding !HasNextInstructions}" Classes="muted"/><StackPanel Orientation="Horizontal" Spacing="5"><TextBlock Text="Planned next run:" Classes="muted"/><TextBlock Text="{Binding NextRunAtDisplay}"/></StackPanel></StackPanel><StackPanel Spacing="5"><TextBlock Text="Signals considered" Classes="h2"/><TextBlock Text="No signal IDs recorded." IsVisible="{Binding !HasSignals}" Classes="muted"/><ItemsControl ItemsSource="{Binding SignalIds}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Classes="muted"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></StackPanel></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer></Grid>
<StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="5" Margin="0,14,0,0" HorizontalAlignment="Center"><Button Classes="page" Content="«" ToolTip.Tip="First page" Command="{Binding FirstPageCommand}"/><Button Classes="page" Content="‹" ToolTip.Tip="Previous page" Command="{Binding PreviousPageCommand}"/><ItemsControl ItemsSource="{Binding PageNumbers}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="5"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Button Classes="page" Content="{Binding}" Command="{Binding $parent[ItemsControl].DataContext.GoToPageCommand}" CommandParameter="{Binding}"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><Button Classes="page" Content="›" ToolTip.Tip="Next page" Command="{Binding NextPageCommand}"/><Button Classes="page" Content="»" ToolTip.Tip="Last page" Command="{Binding LastPageCommand}"/><TextBox Width="58" Text="{Binding PageInput, Mode=TwoWay}" KeyDown="PageInputKeyDown" PlaceholderText="Page" HorizontalContentAlignment="Center"/><TextBlock Text="{Binding PageLabel}" Classes="muted" VerticalAlignment="Center" Margin="8,0,0,0"/></StackPanel></Grid></UserControl>
