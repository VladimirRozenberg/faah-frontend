<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="620"
             x:Class="FAAH_Frontend.Views.UserCreateView">

    <Grid Margin="42,26,42,24" RowDefinitions="Auto,Auto,*,Auto,Auto">

        <TextBlock Grid.Row="0" Text="New user" Classes="h1"/>
        <Border Grid.Row="1" Classes="rule" Margin="0,14,0,0"/>

        <Grid Grid.Row="2" ColumnDefinitions="1*,80,1*" Margin="0,30,0,0" VerticalAlignment="Top">

            <StackPanel Grid.Column="0" Spacing="18">
                <StackPanel>
                    <TextBlock Classes="label">
                        <Run Text="Username"/><Run Text="*" Foreground="{StaticResource Amber}"/>
                    </TextBlock>
                    <TextBox Classes="field" Text="{Binding Username}"/>
                </StackPanel>

                <StackPanel>
                    <TextBlock Classes="label">
                        <Run Text="Email"/><Run Text="*" Foreground="{StaticResource Amber}"/>
                    </TextBlock>
                    <TextBox Classes="field" Text="{Binding Email}"/>
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="2" Spacing="18">
                <StackPanel>
                    <TextBlock Classes="label">
                        <Run Text="Temporary password"/><Run Text="*" Foreground="{StaticResource Amber}"/>
                    </TextBlock>
                    <TextBox Classes="field" Text="{Binding TemporaryPassword}" PasswordChar="●"/>
                </StackPanel>

                <StackPanel>
                    <TextBlock Classes="label">
                        <Run Text="Role"/><Run Text="*" Foreground="{StaticResource Amber}"/>
                    </TextBlock>
                    <ComboBox Classes="field" PlaceholderText="Select..." HorizontalAlignment="Stretch"
                              ItemsSource="{Binding Roles}" SelectedItem="{Binding Role}"/>
                </StackPanel>
            </StackPanel>
        </Grid>

        <TextBlock Grid.Row="3" Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}"
                   Foreground="{StaticResource Red}" FontSize="12" TextWrapping="Wrap"
                   Margin="0,0,0,10"/>

        <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="26" HorizontalAlignment="Left">
            <Button Classes="primary" Content="Create User" Width="130" Command="{Binding CreateCommand}"/>
            <Button Classes="ghost" Content="Cancel" Width="110" Command="{Binding CancelCommand}"/>
        </StackPanel>
    </Grid>
</UserControl>
