<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:FAAH_Frontend.Controls"
             x:Class="FAAH_Frontend.Views.AssetDetailView">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="42,26,42,26" Spacing="16">
            <Grid ColumnDefinitions="*,Auto">
                 <Button Content="← Back to assets" Classes="ghost" Command="{Binding BackCommand}" IsEnabled="{Binding !IsSubmitting}" HorizontalAlignment="Left"/>
                 <Button Grid.Column="1" Content="Refresh" Classes="ghost" Command="{Binding RefreshCommand}" IsEnabled="{Binding !IsBusy}"/>
            </Grid>
            <!-- Sur grand écran, le formulaire partage la ligne avec le résumé ; le graphique reste en dessous. -->
            <Grid x:Name="OverviewGrid" ColumnDefinitions="*,440" RowDefinitions="Auto,Auto" MaxWidth="1200" HorizontalAlignment="Stretch">
                <StackPanel Spacing="16">
            <Grid ColumnDefinitions="Auto,*">
                <Grid Width="36" Height="36" Margin="0,0,12,0">
                    <Border CornerRadius="18" Background="{Binding Asset.IconColor}" IsVisible="{Binding !Asset.HasLogo}">
                        <TextBlock Text="{Binding Asset.IconText}" Foreground="White" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <Image Source="{Binding Asset.Logo}" IsVisible="{Binding Asset.HasLogo}" Stretch="Uniform"/>
                </Grid>
                <TextBlock Grid.Column="1" Text="{Binding Title}" Classes="h1" TextWrapping="Wrap" VerticalAlignment="Center"/>
            </Grid>
            <TextBlock Text="{Binding Details}" Classes="muted" TextWrapping="Wrap"/>
                <StackPanel Spacing="4">
                    <TextBlock Text="{Binding Asset.PriceDisplay}" FontSize="28" FontWeight="Bold"/>
                    <TextBlock Text="{Binding Asset.ChangeDisplay}" Classes.up="{Binding Asset.IsUp}" Classes.down="{Binding Asset.IsDown}"/>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                         <TextBlock Text="Volume:" Classes="muted"/>
                        <TextBlock Text="{Binding Asset.Volume}" Classes="muted"/>
                    </StackPanel>
                    <TextBlock Text="{Binding QuoteStatus}" Classes="muted" TextWrapping="Wrap"/>
                </StackPanel>
            <!-- Un petit encadré relie clairement la quantité au portefeuille sélectionné. -->
            <Border x:Name="HoldingsCard" IsVisible="{Binding HasHoldings}" HorizontalAlignment="Left"
                    Background="{StaticResource SurfaceAlt}" BorderBrush="#D5DEE9" BorderThickness="1"
                    CornerRadius="8" Padding="14,10" MinWidth="230" MaxWidth="440">
                <StackPanel Spacing="4">
                    <TextBlock Text="Your holdings" Classes="muted" FontSize="12"/>
                    <TextBlock Text="{Binding HoldingsDisplay}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding SelectedPortfolio.Name}" Classes="muted" FontSize="12" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Border>
                </StackPanel>
                <StackPanel x:Name="TradingPanel" Grid.Column="1" Margin="28,0,0,0" Spacing="12">
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Top" Margin="0">
                    <ComboBox x:Name="TradePortfolioSelector" Width="200" PlaceholderText="Select portfolio"
                              ItemsSource="{Binding Portfolios}" SelectedItem="{Binding SelectedPortfolio, Mode=TwoWay}"
                              IsEnabled="{Binding CanSelectPortfolio}" AutomationProperties.Name="Transaction portfolio">
                        <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/></DataTemplate></ComboBox.ItemTemplate>
                    </ComboBox>
                     <Button Content="Buy" Classes="tradeBuy" Command="{Binding BuyCommand}" IsEnabled="{Binding CanBuy}"/>
                     <Button Content="Sell" Classes="tradeSell" Command="{Binding SellCommand}" IsEnabled="{Binding CanSell}"/>
                </StackPanel>
            <TextBlock Text="{Binding TradingNotice}" IsVisible="{Binding HasTradingNotice}" Classes="muted" TextWrapping="Wrap"/>
            <TextBlock Text="{Binding PortfolioStatus}" Classes="muted" TextWrapping="Wrap"/>
            <Border x:Name="OrderCard" IsVisible="{Binding IsOrderOpen}" Background="{StaticResource SurfaceAlt}"
                    BorderBrush="#CBD7E5" BorderThickness="1" Padding="22" CornerRadius="10"
                    HorizontalAlignment="Stretch">
                <StackPanel Spacing="16">
                    <StackPanel Spacing="4">
                        <TextBlock Text="{Binding OrderTitle}" FontSize="22" FontWeight="SemiBold"/>
                        <TextBlock Text="Review your order before confirming." Classes="muted"/>
                    </StackPanel>
                    <Border Height="1" Background="#D5DEE9"/>
                    <Grid ColumnDefinitions="Auto,*">
                        <TextBlock Text="Portfolio" Classes="muted" Margin="0,0,24,0"/>
                        <TextBlock Grid.Column="1" Text="{Binding SelectedPortfolio.Name}" FontWeight="SemiBold" TextWrapping="Wrap" HorizontalAlignment="Right"/>
                    </Grid>
                    <StackPanel Spacing="6">
                        <TextBlock Text="Quantity" FontWeight="SemiBold"/>
                        <NumericUpDown Value="{Binding Quantity}" Minimum="0.00000001" Maximum="99999999" Increment="1"
                                       FormatString="0.########" IsEnabled="{Binding !IsSubmitting}" HorizontalAlignment="Stretch" MinHeight="40"/>
                    </StackPanel>
                    <!-- Prix et total séparés pour faciliter la vérification avant confirmation. -->
                    <Border Background="White" CornerRadius="6" Padding="14">
                        <StackPanel Spacing="10">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="Estimated unit price" Classes="muted" Margin="0,0,24,0"/>
                                <TextBlock Grid.Column="1" Text="{Binding OrderUnitPrice}"/>
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="Estimated total" VerticalAlignment="Center" Margin="0,0,24,0"/>
                                <TextBlock Grid.Column="1" Text="{Binding OrderTotal}" FontSize="22" FontWeight="SemiBold"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="Excluding fees. The final execution price may vary." Classes="muted" TextWrapping="Wrap"/>
                    <Grid ColumnDefinitions="*,Auto">
                        <Button Content="{Binding ConfirmOrderLabel}" Classes.tradeBuy="{Binding IsBuyOrder}" Classes.tradeSell="{Binding !IsBuyOrder}"
                                Command="{Binding SubmitOrderCommand}" IsEnabled="{Binding CanSubmitOrder}" HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center" Padding="20,12"/>
                        <Button Grid.Column="1" Content="Cancel" Classes="ghost" Margin="10,0,0,0" Padding="18,12"
                                Command="{Binding CloseOrderCommand}" IsEnabled="{Binding !IsSubmitting}"/>
                    </Grid>
                </StackPanel>
            </Border>
            <TextBlock Text="{Binding OrderStatus}" TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>
            <Border Classes="rule"/>
             <TextBlock Text="Price history" Classes="h2"/>
            <StackPanel Orientation="Horizontal" Spacing="20" IsEnabled="{Binding HasHistoryOptions}">
                <StackPanel Spacing="5">
                     <TextBlock Text="Displayed period"/>
                    <ComboBox Width="160" ItemsSource="{Binding Periods}" SelectedItem="{Binding SelectedPeriod, Mode=TwoWay}"/>
                </StackPanel>
                <StackPanel Spacing="5">
                     <TextBlock Text="Candle interval"/>
                    <ComboBox Width="160" ItemsSource="{Binding Intervals}" SelectedItem="{Binding SelectedInterval, Mode=TwoWay}"/>
                </StackPanel>
            </StackPanel>
             <TextBlock Text="m = minute · h = hour · d = day · wk = week · mo = month · y = year" Classes="muted" TextWrapping="Wrap"/>
            <TextBlock Text="{Binding ChartStatus}" Classes="muted" TextWrapping="Wrap"/>
            <controls:CandleChart Candles="{Binding Candles}" Height="300" MinWidth="280"/>
            <Border Classes="rule"/>
             <TextBlock Text="Asset news" Classes="h2"/>
            <TextBlock Text="{Binding NewsStatus}" Classes="muted" TextWrapping="Wrap"/>
            <ItemsControl ItemsSource="{Binding News}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource SurfaceAlt}" Padding="16" Margin="0,0,0,10" CornerRadius="6">
                            <StackPanel Spacing="7">
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <TextBlock Text="{Binding Source}" Classes="muted"/>
                                    <TextBlock Text="{Binding DateDisplay}" Classes="muted"/>
                                </StackPanel>
                                <TextBlock Text="{Binding Summary}" TextWrapping="Wrap"/>
                                 <Button Content="More info" Classes="ghost"
                                         Command="{Binding $parent[ItemsControl].DataContext.OpenArticleCommand}"
                                         CommandParameter="{Binding Id}"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
    <UserControl.Styles>
        <Style Selector="Button.tradeBuy"><Setter Property="Background" Value="{StaticResource GreenSolid}"/><Setter Property="Foreground" Value="White"/></Style>
        <Style Selector="Button.tradeSell"><Setter Property="Background" Value="{StaticResource RedSolid}"/><Setter Property="Foreground" Value="White"/></Style>
        <!-- Désactivé = gris, pour rendre l'obligation de choisir un portefeuille visible. -->
        <Style Selector="Button.tradeBuy:disabled, Button.tradeSell:disabled"><Setter Property="Background" Value="#D5D9DE"/><Setter Property="Foreground" Value="#697386"/></Style>
    </UserControl.Styles>
</UserControl>
