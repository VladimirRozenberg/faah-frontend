<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:FAAH_Frontend.Controls"
             x:Class="FAAH_Frontend.Views.AssetDetailView">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel x:Name="PageContent" Margin="42,26,42,26" Spacing="20">
            <Grid ColumnDefinitions="*,Auto">
                 <Button Content="← Back to assets" Classes="ghost" Command="{Binding BackCommand}" IsEnabled="{Binding !IsSubmitting}" HorizontalAlignment="Left"/>
                 <Button Grid.Column="1" Content="Refresh" Classes="ghost" Command="{Binding RefreshCommand}" IsEnabled="{Binding !IsBusy}"/>
            </Grid>
            <!-- Résumé aligné sur le graphique, sans largeur maximale centrée. -->
            <Grid x:Name="OverviewGrid" ColumnDefinitions="*,360" RowDefinitions="Auto,Auto">
                <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="Auto,*">
                        <Grid Width="36" Height="36" Margin="0,0,12,0">
                            <Border CornerRadius="18" Background="{Binding Asset.IconColor}" IsVisible="{Binding !Asset.HasLogo}">
                                <TextBlock Text="{Binding Asset.IconText}" Foreground="White" FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <Image Source="{Binding Asset.Logo}" IsVisible="{Binding Asset.HasLogo}" Stretch="Uniform"/>
                        </Grid>
                        <TextBlock Grid.Column="1" Text="{Binding Title}" Classes="h1" TextWrapping="Wrap" VerticalAlignment="Center"/>
                    </Grid>
                    <TextBlock Text="{Binding Details}" Classes="muted" TextWrapping="Wrap"/>
                    <StackPanel Spacing="4">
                        <TextBlock Text="{Binding Asset.PriceDisplay}" FontSize="30" FontWeight="Bold"/>
                        <TextBlock Text="{Binding Asset.ChangeDisplay}" Classes.up="{Binding Asset.IsUp}" Classes.down="{Binding Asset.IsDown}"/>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="Volume:" Classes="muted"/>
                            <TextBlock Text="{Binding Asset.Volume}" Classes="muted"/>
                        </StackPanel>
                        <TextBlock Text="{Binding QuoteStatus}" Classes="muted" TextWrapping="Wrap"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel x:Name="TradingPanel" Grid.Column="1" Margin="24,0,0,0" Spacing="10">
                    <TextBlock Text="Your portfolio" FontWeight="SemiBold"/>
                    <Grid ColumnDefinitions="*,Auto,Auto">
                        <ComboBox x:Name="TradePortfolioSelector" HorizontalAlignment="Stretch" PlaceholderText="Select portfolio"
                                  ItemsSource="{Binding Portfolios}" SelectedItem="{Binding SelectedPortfolio, Mode=TwoWay}"
                                  IsEnabled="{Binding CanSelectPortfolio}" AutomationProperties.Name="Transaction portfolio">
                            <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/></DataTemplate></ComboBox.ItemTemplate>
                        </ComboBox>
                        <Button Grid.Column="1" Margin="8,0,0,0" Content="Buy" Classes="tradeBuy" Command="{Binding BuyCommand}" IsEnabled="{Binding CanBuy}"/>
                        <Button Grid.Column="2" Margin="8,0,0,0" Content="Sell" Classes="tradeSell" Command="{Binding SellCommand}" IsEnabled="{Binding CanSell}"/>
                    </Grid>
                    <Border x:Name="HoldingsCard" IsVisible="{Binding HasHoldings}" Background="{StaticResource SurfaceAlt}"
                            BorderBrush="#D5DEE9" BorderThickness="1" CornerRadius="8" Padding="14,10">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Your holdings" Classes="muted" FontSize="12"/>
                            <TextBlock Text="{Binding HoldingsDisplay}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding SelectedPortfolio.Name}" Classes="muted" FontSize="12" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
            <TextBlock Text="{Binding TradingNotice}" IsVisible="{Binding HasTradingNotice}" Classes="muted" TextWrapping="Wrap"/>
            <TextBlock Text="{Binding PortfolioStatus}" IsVisible="{Binding HasPortfolioStatus}" Classes="muted" TextWrapping="Wrap"/>
            <!-- Le formulaire s'étale en colonnes sur grand écran, puis se replie sans dupliquer les champs. -->
            <Border x:Name="OrderCard" IsVisible="{Binding IsOrderOpen}" Background="{StaticResource SurfaceAlt}"
                    BorderBrush="#CBD7E5" BorderThickness="1" Padding="22" CornerRadius="10">
                <Grid x:Name="OrderGrid" ColumnDefinitions="*,*,*,*" RowDefinitions="Auto,Auto,Auto,Auto">
                    <StackPanel x:Name="OrderIdentity" Spacing="8">
                        <TextBlock Text="{Binding OrderTitle}" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <TextBlock Text="Review your order" Classes="muted"/>
                        <TextBlock Text="{Binding SelectedPortfolio.Name}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    </StackPanel>
                    <StackPanel x:Name="OrderQuantity" Grid.Column="1" Margin="24,0,0,0" Spacing="8">
                        <ComboBox x:Name="OrderInputModeSelector" ItemsSource="{Binding OrderInputModes}"
                                  SelectedItem="{Binding OrderInputMode, Mode=TwoWay}" HorizontalAlignment="Stretch"
                                  IsEnabled="{Binding !IsSubmitting}" AutomationProperties.Name="Enter quantity or amount"/>
                        <TextBlock Text="Quantity" FontWeight="SemiBold" IsVisible="{Binding IsQuantityMode}"/>
                        <TextBlock Text="{Binding AmountLabel}" FontWeight="SemiBold" IsVisible="{Binding IsAmountMode}"/>
                        <!-- Un seul encadré : le champ actif et ALL à droite, uniquement pour vendre. -->
                        <Border BorderBrush="#8A8A8A" BorderThickness="1" CornerRadius="3" Background="#FAFAFB">
                            <Grid ColumnDefinitions="*,Auto">
                                <NumericUpDown x:Name="OrderQuantityInput" Value="{Binding Quantity, Mode=TwoWay}" IsVisible="{Binding IsQuantityMode}"
                                               Minimum="0" Maximum="99999999" ShowButtonSpinner="False" AllowSpin="False" BorderThickness="0"
                                               FormatString="0.########" IsEnabled="{Binding !IsSubmitting}" HorizontalAlignment="Stretch" MinHeight="40"/>
                                <NumericUpDown x:Name="OrderAmountInput" Value="{Binding CashAmount, Mode=TwoWay}" IsVisible="{Binding IsAmountMode}"
                                               Minimum="0" Maximum="{Binding CashAmountMaximum}" ShowButtonSpinner="False" AllowSpin="False" BorderThickness="0"
                                               FormatString="0.00" IsEnabled="{Binding !IsSubmitting}" HorizontalAlignment="Stretch" MinHeight="40"/>
                                <Button x:Name="SellAllButton" Grid.Column="1" Content="ALL" Classes="ghost" Margin="4" Padding="12,5"
                                        FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" IsVisible="{Binding !IsBuyOrder}"
                                        IsEnabled="{Binding CanSellAll}" Command="{Binding SellAllCommand}"
                                        ToolTip.Tip="Sell all your holdings" AutomationProperties.Name="Sell all holdings"/>
                            </Grid>
                        </Border>
                        <TextBlock Text="Estimated unit price" Classes="muted"/>
                        <TextBlock Text="{Binding OrderUnitPrice}" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Border x:Name="OrderSummary" Grid.Column="2" Margin="24,0,0,0" Background="White" CornerRadius="6" Padding="14">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Estimated total" Classes="muted"/>
                            <TextBlock Text="{Binding OrderTotal}" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding OrderQuantityDisplay}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            <!-- Prix local puis conversion : le total principal reste en USD. -->
                            <Border x:Name="OrderConversionCard" IsVisible="{Binding HasOrderConversion}" Background="#EDF3FA"
                                    CornerRadius="6" Padding="10">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Currency conversion" FontWeight="SemiBold" FontSize="12"/>
                                    <TextBlock Text="{Binding OrderOriginalTotal}" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding OrderExchangeRate}" Classes="muted" TextWrapping="Wrap" FontSize="12"/>
                                    <TextBlock Text="{Binding OrderRateDate}" Classes="muted" FontSize="11"/>
                                </StackPanel>
                            </Border>
                            <TextBlock Text="Excluding fees. The final amount may vary with the execution price." Classes="muted" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                    <StackPanel x:Name="OrderActions" Grid.Column="3" Margin="24,0,0,0" Spacing="8" VerticalAlignment="Center">
                        <Button Content="{Binding ConfirmOrderLabel}" Classes.tradeBuy="{Binding IsBuyOrder}" Classes.tradeSell="{Binding !IsBuyOrder}"
                                Command="{Binding SubmitOrderCommand}" IsEnabled="{Binding CanSubmitOrder}" HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center" Padding="18,12"/>
                        <Button Content="Cancel" Classes="ghost" Padding="18,10" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                Command="{Binding CloseOrderCommand}" IsEnabled="{Binding !IsSubmitting}"/>
                    </StackPanel>
                </Grid>
            </Border>
            <TextBlock Text="{Binding OrderStatus}" IsVisible="{Binding HasOrderStatus}" TextWrapping="Wrap"/>
            <Border Classes="rule"/>
             <TextBlock Text="Price history" Classes="h2"/>
            <StackPanel Orientation="Horizontal" Spacing="20" IsEnabled="{Binding HasHistoryOptions}">
                <StackPanel Spacing="5">
                     <TextBlock Text="Displayed period"/>
                    <ComboBox Width="160" ItemsSource="{Binding Periods}" SelectedItem="{Binding SelectedPeriod, Mode=TwoWay}"/>
                </StackPanel>
                <StackPanel Spacing="5">
                     <TextBlock Text="Candle interval"/>
                    <ComboBox Width="160" ItemsSource="{Binding Intervals}" SelectedItem="{Binding SelectedInterval, Mode=TwoWay}"/>
                </StackPanel>
            </StackPanel>
             <TextBlock Text="m = minute · h = hour · d = day · wk = week · mo = month · y = year" Classes="muted" TextWrapping="Wrap"/>
            <TextBlock Text="{Binding ChartStatus}" Classes="muted" TextWrapping="Wrap"/>
            <controls:CandleChart Candles="{Binding Candles}" Height="300" MinWidth="280"/>
            <Border Classes="rule"/>
             <TextBlock Text="Asset news" Classes="h2"/>
            <TextBlock Text="{Binding NewsStatus}" Classes="muted" TextWrapping="Wrap"/>
            <ItemsControl ItemsSource="{Binding News}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource SurfaceAlt}" Padding="16" Margin="0,0,0,10" CornerRadius="6">
                            <StackPanel Spacing="7">
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <TextBlock Text="{Binding Source}" Classes="muted"/>
                                    <TextBlock Text="{Binding DateDisplay}" Classes="muted"/>
                                </StackPanel>
                                <TextBlock Text="{Binding Summary}" TextWrapping="Wrap"/>
                                 <Button Content="More info" Classes="ghost"
                                         Command="{Binding $parent[ItemsControl].DataContext.OpenArticleCommand}"
                                         CommandParameter="{Binding Id}"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
    <UserControl.Styles>
        <Style Selector="Button.tradeBuy"><Setter Property="Background" Value="{StaticResource GreenSolid}"/><Setter Property="Foreground" Value="White"/></Style>
        <Style Selector="Button.tradeSell"><Setter Property="Background" Value="{StaticResource RedSolid}"/><Setter Property="Foreground" Value="White"/></Style>
        <!-- Désactivé = gris, pour rendre l'obligation de choisir un portefeuille visible. -->
        <Style Selector="Button.tradeBuy:disabled, Button.tradeSell:disabled"><Setter Property="Background" Value="#D5D9DE"/><Setter Property="Foreground" Value="#697386"/></Style>
    </UserControl.Styles>
</UserControl>
