<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:FAAH_Frontend.Controls"
             x:Class="FAAH_Frontend.Views.AssetDetailView">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="42,26,42,26" Spacing="16">
            <Grid ColumnDefinitions="*,Auto">
                 <Button Content="← Back to assets" Classes="ghost" Command="{Binding BackCommand}" IsEnabled="{Binding !IsSubmitting}" HorizontalAlignment="Left"/>
                 <Button Grid.Column="1" Content="Refresh" Classes="ghost" Command="{Binding RefreshCommand}" IsEnabled="{Binding !IsBusy}"/>
            </Grid>
            <Grid ColumnDefinitions="Auto,*">
                <Grid Width="36" Height="36" Margin="0,0,12,0">
                    <Border CornerRadius="18" Background="{Binding Asset.IconColor}" IsVisible="{Binding !Asset.HasLogo}">
                        <TextBlock Text="{Binding Asset.IconText}" Foreground="White" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <Image Source="{Binding Asset.Logo}" IsVisible="{Binding Asset.HasLogo}" Stretch="Uniform"/>
                </Grid>
                <TextBlock Grid.Column="1" Text="{Binding Title}" Classes="h1" TextWrapping="Wrap" VerticalAlignment="Center"/>
            </Grid>
            <TextBlock Text="{Binding Details}" Classes="muted" TextWrapping="Wrap"/>
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="4">
                    <TextBlock Text="{Binding Asset.PriceDisplay}" FontSize="28" FontWeight="Bold"/>
                    <TextBlock Text="{Binding Asset.ChangeDisplay}" Classes.up="{Binding Asset.IsUp}" Classes.down="{Binding Asset.IsDown}"/>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                         <TextBlock Text="Volume:" Classes="muted"/>
                        <TextBlock Text="{Binding Asset.Volume}" Classes="muted"/>
                    </StackPanel>
                    <TextBlock Text="{Binding QuoteStatus}" Classes="muted" TextWrapping="Wrap"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Top" Margin="16,0,0,0">
                    <ComboBox x:Name="TradePortfolioSelector" Width="200" PlaceholderText="Select portfolio"
                              ItemsSource="{Binding Portfolios}" SelectedItem="{Binding SelectedPortfolio, Mode=TwoWay}"
                              IsEnabled="{Binding CanSelectPortfolio}" AutomationProperties.Name="Transaction portfolio">
                        <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/></DataTemplate></ComboBox.ItemTemplate>
                    </ComboBox>
                     <Button Content="Buy" Classes="tradeBuy" Command="{Binding BuyCommand}" IsEnabled="{Binding CanBuy}"/>
                     <Button Content="Sell" Classes="tradeSell" Command="{Binding SellCommand}" IsEnabled="{Binding CanSell}"/>
                </StackPanel>
            </Grid>
            <TextBlock Text="{Binding TradingNotice}" Classes="muted" TextWrapping="Wrap"/>
            <TextBlock Text="{Binding PortfolioStatus}" Classes="muted" TextWrapping="Wrap"/>
            <TextBlock Text="{Binding HoldingsDisplay}" Classes="muted"/>
            <Border IsVisible="{Binding IsOrderOpen}" Background="{StaticResource SurfaceAlt}" Padding="16" CornerRadius="6">
                <StackPanel Spacing="10">
                    <TextBlock Text="{Binding OrderSide}" Classes="h2"/>
                     <TextBlock Text="Simulation only - no real money is involved."/>
                     <TextBlock Text="Quantity"/>
                    <NumericUpDown Value="{Binding Quantity}" Minimum="0.00000001" Maximum="99999999" Increment="1" FormatString="0.########" IsEnabled="{Binding !IsSubmitting}" HorizontalAlignment="Left" Width="220"/>
                    <TextBlock Text="{Binding OrderEstimate}" TextWrapping="Wrap"/>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                         <Button Content="Confirm simulation" Command="{Binding SubmitOrderCommand}" IsEnabled="{Binding CanSubmitOrder}"/>
                         <Button Content="Cancel" Command="{Binding CloseOrderCommand}" IsEnabled="{Binding !IsSubmitting}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
            <TextBlock Text="{Binding OrderStatus}" TextWrapping="Wrap"/>
            <Border Classes="rule"/>
             <TextBlock Text="Price history" Classes="h2"/>
            <StackPanel Orientation="Horizontal" Spacing="20" IsEnabled="{Binding HasHistoryOptions}">
                <StackPanel Spacing="5">
                     <TextBlock Text="Displayed period"/>
                    <ComboBox Width="160" ItemsSource="{Binding Periods}" SelectedItem="{Binding SelectedPeriod, Mode=TwoWay}"/>
                </StackPanel>
                <StackPanel Spacing="5">
                     <TextBlock Text="Candle interval"/>
                    <ComboBox Width="160" ItemsSource="{Binding Intervals}" SelectedItem="{Binding SelectedInterval, Mode=TwoWay}"/>
                </StackPanel>
            </StackPanel>
             <TextBlock Text="m = minute · h = hour · d = day · wk = week · mo = month · y = year" Classes="muted" TextWrapping="Wrap"/>
            <TextBlock Text="{Binding ChartStatus}" Classes="muted" TextWrapping="Wrap"/>
            <controls:CandleChart Candles="{Binding Candles}" Height="300" MinWidth="280"/>
            <Border Classes="rule"/>
             <TextBlock Text="Asset news" Classes="h2"/>
            <TextBlock Text="{Binding NewsStatus}" Classes="muted" TextWrapping="Wrap"/>
            <ItemsControl ItemsSource="{Binding News}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource SurfaceAlt}" Padding="16" Margin="0,0,0,10" CornerRadius="6">
                            <StackPanel Spacing="7">
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <TextBlock Text="{Binding Source}" Classes="muted"/>
                                    <TextBlock Text="{Binding DateDisplay}" Classes="muted"/>
                                </StackPanel>
                                <TextBlock Text="{Binding Summary}" TextWrapping="Wrap"/>
                                 <Button Content="Read article ↗" Click="OpenArticle" CommandParameter="{Binding OriginalUrl}" Classes="ghost"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
    <UserControl.Styles>
        <Style Selector="Button.tradeBuy"><Setter Property="Background" Value="{StaticResource GreenSolid}"/><Setter Property="Foreground" Value="White"/></Style>
        <Style Selector="Button.tradeSell"><Setter Property="Background" Value="{StaticResource RedSolid}"/><Setter Property="Foreground" Value="White"/></Style>
        <!-- Désactivé = gris, pour rendre l'obligation de choisir un portefeuille visible. -->
        <Style Selector="Button.tradeBuy:disabled, Button.tradeSell:disabled"><Setter Property="Background" Value="#D5D9DE"/><Setter Property="Foreground" Value="#697386"/></Style>
    </UserControl.Styles>
</UserControl>
