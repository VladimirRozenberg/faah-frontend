<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="700"
             x:Class="FAAH_Frontend.Views.LoginView">

    <Grid ColumnDefinitions="1.05*,1*">

        <!-- Panneau marque -->
        <Border Grid.Column="0" Background="{StaticResource NavyDeep}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="18" Width="320">

                <Border Width="62" Height="62" CornerRadius="16" Background="#16406F"
                        HorizontalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="4"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Rectangle Width="6" Height="16" RadiusX="2" RadiusY="2" Fill="#4CAF7D" VerticalAlignment="Bottom"/>
                        <Rectangle Width="6" Height="26" RadiusX="2" RadiusY="2" Fill="#E7EBEF" VerticalAlignment="Bottom"/>
                        <Rectangle Width="6" Height="21" RadiusX="2" RadiusY="2" Fill="{StaticResource Amber}" VerticalAlignment="Bottom"/>
                    </StackPanel>
                </Border>

                <TextBlock Text="FAAH" FontSize="42" FontWeight="Bold" Foreground="#FFFFFF"
                           HorizontalAlignment="Center"/>

                <TextBlock Text="Futures Arbitrage Assets Hub" FontSize="15" Foreground="#D6DEE8"
                           HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>

                <Border Height="3" Width="58" CornerRadius="2" Background="#FFFFFF" Opacity="0.55"
                        HorizontalAlignment="Center" Margin="0,6,0,0"/>

                <TextBlock Text="Smart trading, simplified" FontSize="13" Foreground="#B9C4D1"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Formulaire -->
        <Border Grid.Column="1" Background="{StaticResource Surface}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="300">

                <TextBlock Text="Welcome Back" FontSize="27" FontWeight="Bold"/>
                <TextBlock Text="Sign in to continue to your dashboard" FontSize="13"
                           Foreground="{StaticResource Muted}" Margin="0,4,0,26"/>

                <TextBlock Text="Username or Email" Classes="label"/>
                <TextBox Classes="field" Text="{Binding Username}" Margin="0,0,0,16"/>

                <TextBlock Text="Password" Classes="label"/>
                <TextBox Classes="field" Text="{Binding Password}" PasswordChar="●"/>

                <TextBlock Text="Forgot password?" FontSize="13" HorizontalAlignment="Right"
                           Margin="0,10,0,0" Cursor="Hand">
                    <TextBlock.Styles>
                        <Style Selector="TextBlock:pointerover">
                            <Setter Property="Foreground" Value="{StaticResource Navy}"/>
                            <Setter Property="TextDecorations" Value="Underline"/>
                        </Style>
                    </TextBlock.Styles>
                </TextBlock>

                <TextBlock Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}"
                           Foreground="{StaticResource Red}" FontSize="12"
                           TextWrapping="Wrap" Margin="0,12,0,0"/>

                <Button Content="Sign in" Classes="primary" Command="{Binding LoginCommand}"
                        HorizontalAlignment="Stretch" Height="46" FontSize="20" CornerRadius="4"
                        Margin="0,22,0,0"/>

                <TextBlock HorizontalAlignment="Center" Margin="0,16,0,0" FontSize="13">
                    <Run Text="Don't have an account?"/>
                    <Run Text=" Sign Up" FontWeight="SemiBold" Foreground="{StaticResource Navy}"/>
                </TextBlock>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
