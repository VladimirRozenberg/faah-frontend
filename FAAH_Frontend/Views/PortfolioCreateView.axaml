<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="FAAH_Frontend.Views.PortfolioCreateView">
  <Grid Margin="42,26,42,24" RowDefinitions="Auto,Auto,*,Auto,Auto">
    <TextBlock Grid.Row="0" Text="{Binding PageTitle}" Classes="h1"/>
    <Border Grid.Row="1" Classes="rule" Margin="0,14,0,0"/>
    <ScrollViewer Grid.Row="2" Margin="0,28,0,20" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
      <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="1*,80,1*" RowSpacing="28">
        <StackPanel Grid.Row="0" Grid.Column="0" Spacing="16">
          <StackPanel>
            <TextBlock Classes="label" Text="Name *"/>
            <TextBox Classes="field" MaxLength="200" Text="{Binding Name, Mode=TwoWay}"/>
            <TextBlock Text="{Binding NameError}" Foreground="{StaticResource Red}"/>
          </StackPanel>
          <StackPanel>
            <TextBlock Classes="label" Text="Description"/>
            <TextBox Classes="field" Height="80" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" MaxLength="2000" Text="{Binding Description, Mode=TwoWay}"/>
            <TextBlock Text="Leave blank to clear the existing description." Classes="muted" FontSize="11" IsVisible="{Binding IsEditMode}"/>
            <TextBlock Text="{Binding DescriptionError}" Foreground="{StaticResource Red}"/>
          </StackPanel>
          <StackPanel>
            <TextBlock Classes="label" Text="Strategy"/>
            <ComboBox Classes="field" ItemsSource="{Binding StrategyTypes}" SelectedItem="{Binding StrategyType, Mode=TwoWay}"/>
            <TextBlock Text="Choose Not set to clear the existing strategy." Classes="muted" FontSize="11" IsVisible="{Binding IsEditMode}"/>
            <TextBlock Text="{Binding StrategyTypeError}" Foreground="{StaticResource Red}"/>
          </StackPanel>
          <StackPanel>
            <TextBlock Classes="label" Text="Preferred asset types"/>
            <TextBlock Text="Optional preferences used to find relevant opportunities; they are not trading restrictions." Classes="muted" FontSize="11" TextWrapping="Wrap"/>
            <ItemsControl ItemsSource="{Binding AssetTypes}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <CheckBox Content="{Binding DisplayName}" IsChecked="{Binding IsSelected, Mode=TwoWay}" Margin="0,4,0,0"/>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </StackPanel>
        <StackPanel Grid.Row="0" Grid.Column="2" Spacing="16">
          <StackPanel>
            <TextBlock Classes="label" Text="Risk tolerance"/>
            <ComboBox Classes="field" ItemsSource="{Binding RiskTolerances}" SelectedItem="{Binding RiskTolerance, Mode=TwoWay}"/>
            <TextBlock Text="{Binding RiskToleranceError}" Foreground="{StaticResource Red}"/>
          </StackPanel>
          <StackPanel>
            <TextBlock Classes="label" Text="Max position size (%)"/>
            <TextBox Classes="field" Text="{Binding MaxPositionSizePct, Mode=TwoWay}"/>
            <TextBlock Text="Leave blank to clear the existing value." Classes="muted" FontSize="11" IsVisible="{Binding IsEditMode}"/>
            <TextBlock Text="{Binding MaxPositionSizePctError}" Foreground="{StaticResource Red}"/>
          </StackPanel>
          <StackPanel>
            <TextBlock Classes="label" Text="Max open positions"/>
            <TextBox Classes="field" Text="{Binding MaxOpenPositions, Mode=TwoWay}"/>
            <TextBlock Text="{Binding MaxOpenPositionsError}" Foreground="{StaticResource Red}"/>
          </StackPanel>
          <TextBlock Text="Base currency: USD" Classes="muted"/>
        </StackPanel>
        <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Spacing="8">
          <TextBlock Classes="label" Text="Preferred niches"/>
          <TextBlock Text="Optional preferences used by the strategist to find more relevant opportunities. Assets outside these selections remain allowed." Classes="muted" FontSize="11" TextWrapping="Wrap"/>
          <TextBlock Text="Loading niches..." IsVisible="{Binding IsLoadingNiches}" Classes="muted"/>
          <TextBlock Text="{Binding NicheLoadError}" IsVisible="{Binding HasNicheLoadError}" Foreground="{StaticResource Red}" TextWrapping="Wrap"/>
          <ItemsControl ItemsSource="{Binding Niches}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel Orientation="Horizontal"/>
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Width="280" Margin="0,0,12,10" Padding="10" Background="{StaticResource SurfaceAlt}" CornerRadius="4">
                  <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}">
                    <StackPanel>
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                      <TextBlock Text="{Binding Category}" Classes="muted" FontSize="11" TextWrapping="Wrap"/>
                      <TextBlock Text="{Binding Description}" Classes="muted" FontSize="11" TextWrapping="Wrap" MaxLines="2"/>
                    </StackPanel>
                  </CheckBox>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Grid>
    </ScrollViewer>
    <TextBlock Grid.Row="3" Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}" Foreground="{StaticResource Red}"/>
    <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="26">
      <Button Classes="primary" Content="{Binding SubmitButtonText}" Width="145" IsEnabled="{Binding CanSubmit}" Command="{Binding SubmitCommand}"/>
      <Button Classes="ghost" Content="Cancel" Width="110" Command="{Binding CancelCommand}"/>
    </StackPanel>
  </Grid>
</UserControl>

