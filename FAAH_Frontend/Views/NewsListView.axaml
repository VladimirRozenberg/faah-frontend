<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="FAAH_Frontend.Views.NewsListView">
  <Grid Margin="42,26,42,20" RowDefinitions="Auto,Auto,Auto,*,Auto">
    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
      <TextBlock Text="News" Classes="h1"/>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
        <StackPanel Spacing="2">
          <TextBlock Text="From" Classes="muted" FontSize="10"/>
          <DatePicker Width="92" Height="26" FontSize="10" SelectedDate="{Binding PublishedFromDate, Mode=TwoWay}"/>
        </StackPanel>
        <StackPanel Spacing="2">
          <TextBlock Text="To" Classes="muted" FontSize="10"/>
          <DatePicker Width="92" Height="26" FontSize="10" SelectedDate="{Binding PublishedToDate, Mode=TwoWay}"/>
        </StackPanel>
      </StackPanel>
      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
        <Button Classes="ghost refreshButton" Content="Refresh" Command="{Binding RefreshCommand}"/>
      </StackPanel>
    </Grid>
    <Border Grid.Row="1" Classes="rule" Margin="0,12,0,0"/>
    <StackPanel Grid.Row="2" Spacing="6" Margin="0,8,0,14">
      <TextBlock Text="{Binding Updated}" Classes="muted" FontSize="12"/>
      <TextBlock Text="Loading news…" IsVisible="{Binding IsBusy}"/>
      <TextBlock Text="{Binding Error}" IsVisible="{Binding HasError}" Foreground="{StaticResource Red}" TextWrapping="Wrap"/>
      <TextBlock Text="No news available yet." IsVisible="{Binding IsEmpty}" Classes="muted"/>
    </StackPanel>
    <Grid Grid.Row="3" ColumnDefinitions="*,270" ColumnSpacing="16">
      <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
        <ItemsControl ItemsSource="{Binding Articles}"><ItemsControl.ItemTemplate><DataTemplate>
          <StackPanel Margin="0,0,0,8" Spacing="4">
            <Button Classes="rowButton" Classes.zebra="{Binding IsAlternateRow}" Padding="10" HorizontalContentAlignment="Stretch" ToolTip.Tip="Read article"
                    Command="{Binding $parent[ItemsControl].DataContext.OpenArticleCommand}" CommandParameter="{Binding Id}"><Grid ColumnDefinitions="*,Auto">
              <StackPanel Spacing="6" Margin="0,0,22,0">
                <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="Bold" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding Summary}" FontSize="12" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding Source}" FontSize="12" Classes="muted"/>
              </StackPanel>
              <StackPanel Grid.Column="1" Spacing="4"><TextBlock Text="{Binding DateLabel}" Classes="muted" FontSize="11"/><TextBlock Text="{Binding DateDisplay}" Classes="muted" FontSize="12"/></StackPanel>
            </Grid></Button>
            <StackPanel Orientation="Horizontal" Spacing="6" Margin="10,0,0,0" IsVisible="{Binding HasAssetTags}">
              <TextBlock Text="Assets:" Classes="muted" VerticalAlignment="Center"/>
              <ItemsControl ItemsSource="{Binding AssetTags}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><WrapPanel ItemSpacing="5" LineSpacing="4"/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Button Classes="ghost compact" Content="{Binding}"
                            Command="{Binding $parent[UserControl].DataContext.OpenAssetCommand}"
                            CommandParameter="{Binding}" ToolTip.Tip="Open asset details"/>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </StackPanel>
        </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
      </ScrollViewer>
      <!-- Même présentation que les filtres Assets ; les bindings restent inchangés. -->
      <Border Grid.Column="1" Background="{StaticResource SurfaceAlt}" Padding="14" CornerRadius="8">
        <Grid RowDefinitions="Auto,*">
          <TextBlock Text="Filters" FontSize="16" FontWeight="SemiBold"/>
          <ScrollViewer Grid.Row="1" Margin="0,12,-8,0" Padding="0" VerticalScrollBarVisibility="Auto">
          <StackPanel Spacing="10" Margin="0,12,22,0">
            <TextBlock Text="Search" Classes="label"/>
            <TextBox PlaceholderText="Title, content or URL" Text="{Binding SearchQuery, Mode=TwoWay}"/>
            <TextBlock Text="Processing status" Classes="label"/>
            <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding ProcessedOptions}" SelectedItem="{Binding ProcessedFilter, Mode=TwoWay}"/>
            <TextBlock Text="Asset symbol" Classes="label"/>
            <TextBox PlaceholderText="ex : NVDA" Text="{Binding AssetSymbol, Mode=TwoWay}"/>
            <TextBlock Text="Importance" Classes="label"/>
            <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding ImportanceOptions}" SelectedItem="{Binding ImportanceFilter, Mode=TwoWay}"/>
            <TextBlock Text="Sentiment" Classes="label"/>
            <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding SentimentOptions}" SelectedItem="{Binding SentimentFilter, Mode=TwoWay}"/>
            <TextBlock Text="Trigger status" Classes="label"/>
            <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding TriggerOptions}" SelectedItem="{Binding TriggerFilter, Mode=TwoWay}"/>
            <TextBlock Text="Sort field" Classes="label"/>
            <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding SortByOptions}" SelectedItem="{Binding SortBy, Mode=TwoWay}"/>
            <TextBlock Text="Sort direction" Classes="label"/>
            <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding SortOrderOptions}" SelectedItem="{Binding SortOrder, Mode=TwoWay}"/>
          </StackPanel>
          </ScrollViewer>
        </Grid>
      </Border>
    </Grid>
    <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="5" Margin="0,14,0,0" HorizontalAlignment="Center">
      <Button Classes="page" Content="«" ToolTip.Tip="First page" Command="{Binding FirstPageCommand}"/>
      <Button Classes="page" Content="‹" ToolTip.Tip="Previous page" Command="{Binding PreviousPageCommand}"/>
      <ItemsControl ItemsSource="{Binding PageNumbers}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="5"/></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Button Classes="page" Content="{Binding}"
                    Command="{Binding $parent[ItemsControl].DataContext.GoToPageCommand}"
                    CommandParameter="{Binding}"/>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <Button Classes="page" Content="›" ToolTip.Tip="Next page" Command="{Binding NextPageCommand}"/>
      <Button Classes="page" Content="»" ToolTip.Tip="Last page" Command="{Binding LastPageCommand}"/>
      <TextBox Width="58" Text="{Binding PageInput, Mode=TwoWay}" KeyDown="PageInputKeyDown"
               Watermark="Page" HorizontalContentAlignment="Center"/>
      <TextBlock Text="{Binding PageLabel}" Classes="muted" VerticalAlignment="Center" Margin="8,0,0,0"/>
    </StackPanel>
  </Grid>
</UserControl>
