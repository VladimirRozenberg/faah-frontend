<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="FAAH_Frontend.Views.PersonalInformationView">
  <Grid Margin="42,26" RowDefinitions="Auto,*,Auto">
    <Grid ColumnDefinitions="*,Auto"><TextBlock Text="User profile" Classes="h1"/><Button Grid.Column="1" Content="Refresh" Command="{Binding RefreshCommand}"/></Grid>
    <ScrollViewer Grid.Row="1" Margin="0,20" Padding="0,0,14,0"><StackPanel Spacing="16">
      <Grid ColumnDefinitions="*,Auto"><StackPanel Spacing="6"><TextBlock Text="{Binding Username}" FontSize="22" FontWeight="Bold"/><TextBlock Text="{Binding Email}"/></StackPanel><StackPanel Grid.Column="1" Spacing="6"><TextBlock Text="{Binding User.RoleDisplay}"/></StackPanel></Grid>
      <StackPanel Orientation="Horizontal" Spacing="12" IsVisible="{Binding CanManage}"><Button Content="{Binding User.RoleAction}" Command="{Binding ChangeRoleCommand}"/><Button Content="{Binding User.StatusAction}" Command="{Binding ToggleStatusCommand}"/></StackPanel>
      <Border Classes="rule"/>
      <Grid ColumnDefinitions="*,*"><StackPanel Spacing="8"><TextBlock Text="Available cash" Classes="label"/><TextBlock Text="{Binding Cash}" FontSize="24"/></StackPanel><StackPanel Grid.Column="1" Spacing="8"><TextBlock Text="Asset value" ToolTip.Tip="Sum of held quantities multiplied by the latest available USD prices." Classes="label"/><TextBlock Text="{Binding Assets}" FontSize="24"/></StackPanel></Grid>
      <StackPanel IsVisible="{Binding IsAdmin}" Spacing="8"><TextBlock Text="Top-up (USD) — administrator"/><StackPanel Orientation="Horizontal" Spacing="12"><TextBox Width="180" PlaceholderText="Amount, e.g. 100.00" Text="{Binding DepositAmount}"/><Button Content="Add funds" Command="{Binding DepositCommand}"/></StackPanel></StackPanel>
      <TextBlock Text="Loading…" IsVisible="{Binding IsBusy}"/><TextBlock Text="{Binding Message}" TextWrapping="Wrap"/>
      <TextBlock Text="Transaction history" FontSize="20" FontWeight="Bold"/>
      <TextBlock Text="Number of completed trades per asset" Classes="muted"/>
      <ItemsControl ItemsSource="{Binding TransactionSummary}"><ItemsControl.ItemTemplate><DataTemplate><Border Classes="row" Padding="8,12"><StackPanel Spacing="4"><TextBlock Text="{Binding Label}" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding Name}" Classes="muted"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
      <TextBlock Text="Individual trades" FontSize="16" FontWeight="SemiBold"/>
      <ItemsControl ItemsSource="{Binding Transactions}"><ItemsControl.ItemTemplate><DataTemplate><Border Classes="row" Padding="8,12"><StackPanel Spacing="4"><TextBlock Text="{Binding Label}" TextWrapping="Wrap"/><TextBlock Text="{Binding DisplayName}" Classes="muted"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
    </StackPanel></ScrollViewer>
    <Button Grid.Row="2" Content="Back" Command="{Binding BackCommand}" Classes="ghost"/>
  </Grid>
</UserControl>
